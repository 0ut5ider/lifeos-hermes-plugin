+@patch("hermes_cli.lifecycle.finalize_session")
+def test_prompt_exit_reports_session_end_reason(mock_finalize_session):
+    import cli as cli_mod
+
+    mock_agent = MagicMock()
+    mock_agent.session_id = "prompt-exit-session"
+    cli_mod._active_agent_ref = mock_agent
+    cli_mod._cleanup_done = False
+
+    cli_mod._run_cleanup(reason="prompt_input_exit")
+
+    assert mock_finalize_session.call_args.kwargs["reason"] == "prompt_input_exit"
+
+
+@patch("hermes_cli.lifecycle.finalize_session")
+def test_prompt_exit_without_agent_keeps_session_id(mock_finalize_session):
+    import cli as cli_mod
+
+    cli_mod._active_agent_ref = None
+    cli_mod._cleanup_done = False
+
+    cli_mod._run_cleanup(reason="prompt_input_exit", session_id="unstarted-session")
