+def _plugin_allows_command(command: str, pattern_key: str, description: str) -> bool:
+    """Accept an explicit plugin grant for the recoverable command-pattern warning.
+
+    Callers must check the hardline and user deny floors first. This grant never
+    overrides a separate Tirith finding.
+    """
+    try:
+        from hermes_cli.plugins import invoke_hook
+        decisions = invoke_hook(
+            "pre_command_approval", command=command, pattern_key=pattern_key,
+            description=description, session_key=get_current_session_key(),
+        )
+    except Exception:
+        logger.exception("pre_command_approval hook failed")
+        return False
+    actions = [decision.get("action") for decision in (decisions or []) if isinstance(decision, dict)]
+    return "allow" in actions and "deny" not in actions
+
