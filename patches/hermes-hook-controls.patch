+def get_pre_turn_stop_continue_message(
+    *, session_id: str = "", platform: str = "", model: str = "", attempt: int = 0,
+    final_response: str = "",
+) -> Optional[str]:
+    """Ask plugins whether a candidate answer needs another agent turn."""
+    results = invoke_hook(
+        "pre_turn_stop", session_id=session_id, platform=platform, model=model,
+        attempt=attempt, final_response=final_response,
+    )
+    for result in results:
+        if not isinstance(result, dict):
+            continue
+        action = str(result.get("action") or result.get("decision") or "").strip().lower()
+        message = result.get("message") or result.get("reason")
+        if action in ("continue", "block") and isinstance(message, str) and message.strip():
+            return message.strip()
+    return None
+
