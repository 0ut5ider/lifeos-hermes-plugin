+# ABOUTME: Checks plugin approval decisions against Hermes command safety floors.
+# ABOUTME: Verifies safe grants and refusals at the real command guard entry points.
+
+from unittest.mock import patch
+
+import pytest
+
+from tools import approval_context
+from tools.approval import check_all_command_guards, check_dangerous_command
+
+
+@pytest.fixture(autouse=True)
+def interactive(monkeypatch):
+    monkeypatch.setenv("HERMES_INTERACTIVE", "1")
+    monkeypatch.delenv("HERMES_GATEWAY_SESSION", raising=False)
+    monkeypatch.setattr(approval_context, "_get_approval_mode", lambda: "manual")
+
+
+def test_plugin_grant_skips_dangerous_pattern_prompt():
+    def grant(name, **kwargs):
+        return [{"action": "allow"}] if name == "pre_command_approval" else []
+
+    with patch("hermes_cli.plugins.invoke_hook", side_effect=grant), patch(
+        "tools.tirith_security.check_command_security",
+        return_value={"action": "allow", "findings": [], "summary": ""},
+    ):
+        result = check_all_command_guards(
+            "rm -rf /tmp/plugin-fixture", "local",
+            approval_callback=lambda *args, **kwargs: pytest.fail("Prompt was called"),
+        )
+    assert result["approved"] is True
+
+
+def test_plugin_grant_does_not_skip_tirith_warning():
+    def grant(name, **kwargs):
+        return [{"action": "allow"}] if name == "pre_command_approval" else []
+
+    decisions = []
+
+    def decline(*args, **kwargs):
+        decisions.append(True)
+        return "deny"
+
+    with patch("hermes_cli.plugins.invoke_hook", side_effect=grant), patch(
+        "tools.tirith_security.check_command_security",
+        return_value={"action": "warn", "findings": [{"rule_id": "fixture"}], "summary": "fixture"},
+    ):
+        result = check_all_command_guards("rm -rf /tmp/plugin-fixture", "local", approval_callback=decline)
+    assert result["approved"] is False
+    assert decisions == [True]
+
+
+def test_plugin_grant_does_not_skip_floor():
+    with patch("hermes_cli.plugins.invoke_hook", return_value=[{"action": "allow"}]):
+        assert check_all_command_guards("rm -rf /", "local")["approved"] is False
+
+
+def test_plugin_grant_does_not_skip_user_deny(monkeypatch):
+    monkeypatch.setattr("tools.approval._match_user_deny_rule", lambda command: "rm -rf *")
+    with patch("hermes_cli.plugins.invoke_hook", return_value=[{"action": "allow"}]):
+        assert check_all_command_guards("rm -rf /tmp/plugin-fixture", "local")["approved"] is False
+
+
+def test_plugin_grant_on_simple_guard():
+    def grant(name, **kwargs):
+        return [{"action": "allow"}] if name == "pre_command_approval" else []
+
+    with patch("hermes_cli.plugins.invoke_hook", side_effect=grant):
+        result = check_dangerous_command(
+            "rm -rf /tmp/plugin-fixture", "local",
+            approval_callback=lambda *args, **kwargs: pytest.fail("Prompt was called"),
+        )
+    assert result["approved"] is True
+
+
+def test_plugin_grant_does_not_override_another_plugin_rejection():
+    with patch("hermes_cli.plugins.invoke_hook", return_value=[{"action": "allow"}, {"action": "deny"}]):
+        result = check_dangerous_command(
+            "rm -rf /tmp/plugin-fixture", "local",
+            approval_callback=lambda *args, **kwargs: "deny",
+        )
+    assert result["approved"] is False
