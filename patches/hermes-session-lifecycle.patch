+        summary = await self.adapter._safe_sync_slash_commands()
+        self.assertEqual(summary["updated"], 1)
+        self.assertEqual(self.transport.payloads["123"]["contexts"], [0])
+
+    async def test_description_change_updates_the_existing_command(self):
+        self.command.description = "Stop the running Hermes agent"
+        summary = await self.adapter._safe_sync_slash_commands()
+        self.assertEqual(summary["updated"], 1)
+        self.assertEqual(self.transport.payloads["123"]["description"], self.command.description)
+        self.assertEqual(summary["deleted"], 0)
+
+
+if __name__ == "__main__":
