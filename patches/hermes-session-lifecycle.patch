+        self.assertEqual(summary["updated"], 1)
+        self.assertEqual(self.transport.payloads["123"]["description"], self.command.description)
+        self.assertTrue(self.transport.payloads["123"]["nsfw"])
+
+    async def test_explicit_contexts_do_not_match_other_contexts(self):
