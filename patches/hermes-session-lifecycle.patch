+# ABOUTME: Verifies one guild channel gates Discord message and slash-command admission.
+# ABOUTME: Uses the actual Discord SDK and isolated pairing records for protocol controls.
+import json
+import asyncio
+from pathlib import Path
+import tempfile
+import unittest
+
+import discord
+from gateway.config import PlatformConfig
+from gateway.pairing import PairingStore
+from agent.secret_scope import set_secret_scope, reset_secret_scope
+from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+from plugins.platforms.discord.adapter import DiscordAdapter, _GATE_ENV_KEYS, _standalone_send
+
+
+class GuildChannelOnlyTests(unittest.TestCase):
+    def setUp(self):
+        directory = tempfile.TemporaryDirectory()
+        self.addCleanup(directory.cleanup)
+        token = set_hermes_home_override(Path(directory.name))
+        self.addCleanup(reset_hermes_home_override, token)
+        secret_scope = set_secret_scope({'DISCORD_BOT_TOKEN':''})
+        self.addCleanup(reset_secret_scope, secret_scope)
+        self.client = discord.Client(intents=discord.Intents.none())
+        state = self.client._connection
+        self.bot_data = {'id':'30','username':'SyntheticBot','discriminator':'0000','avatar':None,'bot':True}
+        self.user_data = {'id':'20','username':'SyntheticOwner','discriminator':'0000','avatar':None}
+        state.user = discord.ClientUser(state=state, data=self.bot_data)
+        self.guild = discord.Guild(state=state, data={'id':'10','name':'Synthetic guild','owner_id':'20',
+            'roles':[], 'features':[], 'emojis':[], 'stickers':[], 'afk_timeout':300,
+            'verification_level':0,'default_message_notifications':0,'explicit_content_filter':0,'mfa_level':0})
+        state._guilds[10] = self.guild
+        self.channel_data = {'id':'60','name':'synthetic-private','type':0,'position':0,'permission_overwrites':[]}
+        self.channel = discord.TextChannel(state=state, guild=self.guild, data=self.channel_data)
+        self.other = discord.TextChannel(state=state, guild=self.guild, data={**self.channel_data,'id':'61'})
+        self.dm = discord.DMChannel(state=state, me=state.user, data={'id':'70','recipients':[self.user_data]})
+        self.guild._channels.update({60:self.channel, 61:self.other})
+        state._private_channels[70] = self.dm
+        self.adapter = DiscordAdapter(PlatformConfig(enabled=True))
+        self.adapter._client = self.client
+        self.adapter._allowed_user_ids = {'20'}
+        self.adapter._gate_env_snapshot = {key:'' for key in _GATE_ENV_KEYS}
+        self.adapter.config.extra = {'allowed_channels':['60'], 'guild_channel_only':True}
+
+    def message(self, channel):
+        return discord.Message(state=self.client._connection, channel=channel, data={
+            'id':'100000000000000000','type':0,'author':self.user_data,
+            'content':'<@30> synthetic request','mentions':[self.bot_data],'mention_roles':[],
+            'attachments':[], 'embeds':[], 'flags':0,'pinned':False,'tts':False,
+            'timestamp':'2026-10-07T20:00:00+00:00','edited_timestamp':None})
+
+    def interaction(self, channel):
+        payload = {'id':'100000000000000001','application_id':'30','type':2,'token':'synthetic-token',
+            'attachment_size_limit':33554432, 'entitlements':[],
+            'version':1,'locale':'en-US','app_permissions':'0',
+            'data':{'id':'200000000000000000','name':'status','type':1},
+            'channel_id':str(channel.id), 'channel':{**self.channel_data,'id':str(channel.id)}}
+        if isinstance(channel, discord.DMChannel):
+            payload.update(user=self.user_data,channel={'id':'70','type':1,'recipients':[self.user_data]})
+        else:
+            payload.update(guild_id='10',guild_locale='en-US',member={'user':self.user_data,
+                'roles':[],'joined_at':'2026-10-01T00:00:00+00:00','deaf':False,'mute':False,'permissions':'0','flags':0})
+        return discord.Interaction(data=payload,state=self.client._connection)
+
+    def test_private_channel_accepts_owner_messages_and_status(self):
+        self.assertTrue(self.adapter._discord_message_admission(self.message(self.channel),claim=False)[0])
+        self.assertTrue(self.adapter._evaluate_slash_authorization(self.interaction(self.channel))[0])
+
+    def test_direct_messages_refuse_an_allowlisted_owner(self):
+        self.assertFalse(self.adapter._discord_message_admission(self.message(self.dm),claim=False)[0])
+        self.assertFalse(self.adapter._evaluate_slash_authorization(self.interaction(self.dm))[0])
+
+    def test_pairing_does_not_bypass_the_channel_restriction(self):
+        store = PairingStore()
+        code = store.generate_code('discord','20','SyntheticOwner')
+        self.assertIsNotNone(store.approve_code('discord',code))
+        self.assertTrue(store.is_approved('discord','20'))
+        self.assertFalse(self.adapter._discord_message_admission(self.message(self.dm),claim=False)[0])
+        self.assertFalse(self.adapter._evaluate_slash_authorization(self.interaction(self.dm))[0])
+
+    def test_other_guild_channel_refuses_messages_and_status(self):
+        self.assertFalse(self.adapter._discord_message_admission(self.message(self.other),claim=False)[0])
+        self.assertFalse(self.adapter._evaluate_slash_authorization(self.interaction(self.other))[0])
+
+    def test_outbound_messages_and_files_cannot_resolve_another_destination(self):
+        self.assertIs(asyncio.run(self.adapter._resolve_channel('60')), self.channel)
+        self.assertIsNone(asyncio.run(self.adapter._resolve_channel('61')))
+        self.assertIsNone(asyncio.run(self.adapter._resolve_channel('70')))
+
+    def test_standalone_text_and_media_refuse_another_channel_before_credentials(self):
+        config = PlatformConfig(enabled=True,extra={'guild_channel_only':True,'allowed_channels':['60']})
+        for target, thread in (('61',None), ('70',None), ('60','80')):
+            with self.subTest(target=target,thread=thread):
+                result = asyncio.run(_standalone_send(config,target,'Synthetic outbound request',
+                    thread_id=thread,media_files=[('/synthetic/attachment.txt',False)]))
+                self.assertIn('selected guild text channel',result['error'])
+
+    def test_standalone_selected_channel_reaches_credential_validation(self):
+        config = PlatformConfig(enabled=True,extra={'guild_channel_only':True,'allowed_channels':['60']})
+        result = asyncio.run(_standalone_send(config,'60','Synthetic outbound request'))
+        self.assertEqual(result['error'],'Discord standalone send: DISCORD_BOT_TOKEN is not set')
+
+    def test_channel_only_requires_one_numeric_channel_id(self):
+        for allowed in ([], ['60','61'], ['*'], ['synthetic-private']):
+            with self.subTest(allowed=allowed):
+                self.adapter.config.extra['allowed_channels'] = allowed
+                self.assertFalse(self.adapter._discord_message_admission(self.message(self.channel),claim=False)[0])
+                self.assertFalse(self.adapter._evaluate_slash_authorization(self.interaction(self.channel))[0])
+
+    def test_absent_opt_in_preserves_direct_message_admission(self):
+        self.adapter.config.extra.pop('guild_channel_only')
+        self.assertTrue(self.adapter._discord_message_admission(self.message(self.dm),claim=False)[0])
+        self.assertTrue(self.adapter._evaluate_slash_authorization(self.interaction(self.dm))[0])
+
+
+if __name__ == '__main__':
+    unittest.main()
