+def _command_review_scope(env_type: str, cwd: str, task_id: str) -> tuple[str, str]:
+    """Bind review grants to an authoritative target without opening a backend."""
+    if env_type in {"local", ""}:
+        return ("local", str(Path(cwd or os.getcwd()).resolve()))
+    try:
+        from tools.terminal_tool_lifecycle import get_active_env
+        backend = get_active_env(task_id)
+        workspace = cwd or getattr(backend, "cwd", "")
+        if not posixpath.isabs(workspace):
+            raise ValueError("remote workspace is not absolute")
+        if env_type == "ssh":
+            target = [env_type, backend.host, backend.user, backend.port]
+        elif env_type == "docker" and backend._container_id:
+            target = [env_type, backend._container_id]
+        else:
+            raise ValueError("backend identity is unavailable")
+        return (json.dumps(target, separators=(",", ":")), posixpath.normpath(workspace))
+    except (Exception, SystemExit):
+        # An unknown target cannot reuse a stored grant, even within one task.
+        return (f"unresolved:{uuid.uuid4().hex}", cwd)
+
