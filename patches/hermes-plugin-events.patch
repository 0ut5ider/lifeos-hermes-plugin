diff --git a/tests/hermes_cli/test_required_policy_hooks.py b/tests/hermes_cli/test_required_policy_hooks.py
new file mode 100644
index 00000000..091b24f5
--- /dev/null
+++ b/tests/hermes_cli/test_required_policy_hooks.py
@@ -0,0 +1,75 @@
+# ABOUTME: Verifies required policy callbacks stop operations on failure.
+# ABOUTME: Exercises bounded synchronous and asynchronous plugin dispatch.
+
+import asyncio
+import threading
+import time
+
+import pytest
+
+from hermes_cli.plugins import PluginManager
+
+
+REQUIRED = [("pre_prompt_admission", "block"), ("pre_command_approval", "deny"), ("pre_turn_stop", "fail")]
+
+
+@pytest.mark.parametrize("name,action", REQUIRED)
+@pytest.mark.parametrize("exception", [RuntimeError, SystemExit])
+def test_required_callback_exception_is_a_veto(name, action, exception, monkeypatch, caplog):
+    manager = PluginManager()
+    def failed(**kwargs):
+        raise exception("expected policy failure")
+    manager._hooks[name] = [failed]
+    monkeypatch.setattr("hermes_cli.plugins._resolve_hook_callback_timeout", lambda: 0.02)
+    result = manager.invoke_hook(name)
+    assert result and result[0]["action"] == action
+    assert "expected policy failure" in result[0]["message"]
+    assert "expected policy failure" in caplog.text
+
+
+@pytest.mark.parametrize("name,action", REQUIRED)
+@pytest.mark.parametrize("asynchronous", [False, True])
+def test_timeout_and_suppression_never_admit_a_late_grant(name, action, asynchronous, monkeypatch, caplog):
+    manager = PluginManager()
+    completed = threading.Event()
+    def slow(**kwargs):
+        time.sleep(0.15)
+        completed.set()
+        return {"action": "allow"}
+    manager._hooks[name] = [slow]
+    monkeypatch.setattr("hermes_cli.plugins._resolve_hook_callback_timeout", lambda: 0.02)
+    async def dispatch():
+        return await manager.ainvoke_hook(name)
+    started = time.monotonic()
+    first = asyncio.run(dispatch()) if asynchronous else manager.invoke_hook(name)
+    assert time.monotonic() - started < 0.12
+    second = asyncio.run(dispatch()) if asynchronous else manager.invoke_hook(name)
+    assert first[0]["action"] == second[0]["action"] == action
+    assert completed.wait(1)
+    assert first[0]["action"] == action
+    assert "timed out" in caplog.text
+
+
+def test_optional_context_failure_stays_fail_open(monkeypatch, caplog):
+    manager = PluginManager()
+    def failed(**kwargs):
+        raise RuntimeError("expected optional failure")
+    manager._hooks["pre_llm_call"] = [failed]
+    monkeypatch.setattr("hermes_cli.plugins._resolve_hook_callback_timeout", lambda: 0.02)
+    assert manager.invoke_hook("pre_llm_call") == []
+    assert "expected optional failure" in caplog.text
+
+
+def test_concurrent_commands_have_independent_policy_calls(monkeypatch, caplog):
+    from concurrent.futures import ThreadPoolExecutor
+    manager = PluginManager()
+    barrier = threading.Barrier(2)
+    def guard(**kwargs):
+        barrier.wait(timeout=0.5)
+        return {"action": "allow"}
+    manager._hooks["pre_command_approval"] = [guard]
+    monkeypatch.setattr("hermes_cli.plugins._resolve_hook_callback_timeout", lambda: 0.6)
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        calls = [executor.submit(manager.invoke_hook, "pre_command_approval", command=f"printf {i}") for i in range(2)]
+        assert [call.result() for call in calls] == [[{"action": "allow"}], [{"action": "allow"}]]
+    assert not caplog.text
