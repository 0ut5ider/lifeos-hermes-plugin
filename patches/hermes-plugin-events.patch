new file mode 100644
index 000000000..be892756c
--- /dev/null
+++ b/hermes_cli/plugins_policy.py
@@ -0,0 +1,63 @@
+# ABOUTME: Resolves scoped plugin policy callbacks and explicit final-check directives.
+# ABOUTME: Marks synchronous required middleware without changing facade lookup behavior.
+from __future__ import annotations
+import inspect
+from functools import wraps
+from typing import Callable, Optional
+
+def required_middleware_callback(callback, required):
+    if type(required) is not bool:
+        raise TypeError("required must be a boolean")
+    if not required:
+        return callback
+    call = type(callback).__call__ if callable(callback) else None
+    if any(check(value) for check in (inspect.iscoroutinefunction, inspect.isasyncgenfunction) for value in (callback, call)):
+        raise TypeError("Required middleware must be synchronous")
+    @wraps(callback)
+    def required_callback(**kwargs):
+        return callback(**kwargs)
+    required_callback._hermes_required_middleware = True
+    return required_callback
+
+def has_hook(hook_name: str) -> bool:
+    """True when a loaded plugin handles a hook (lazy-discovers first, like :func:`has_middleware`).
+
+    Lazy-discovers first — same gate-before-invoke rationale as :func:`has_middleware` (tracking #64178).
+    """
+    from hermes_cli.plugins import _delivery_manager
+    return _delivery_manager().has_hook(hook_name)
+
+
+def iter_hook_callbacks(hook_name: str) -> tuple[Callable, ...]:
+    """Return a stable snapshot of callbacks registered for a hook."""
+    from hermes_cli.plugins import get_plugin_manager
+    return get_plugin_manager().iter_hook_callbacks(hook_name)
+
+
+def get_pre_turn_stop_continue_message(
+    *, session_id: str = "", platform: str = "", model: str = "", reasoning_effort: str = "",
+    provider: str = "", attempt: int = 0, final_response: str = "",
+) -> Optional[str | dict[str, str]]:
+    """Ask plugins whether a candidate answer needs another agent turn."""
+    from hermes_cli.plugins import invoke_hook
+    results = invoke_hook(
+        "pre_turn_stop", session_id=session_id, platform=platform, model=model,
+        reasoning_effort=reasoning_effort, provider=provider, attempt=attempt, final_response=final_response,
+    )
+    message = None
+    fail_at_limit = False
+    for result in results:
+        if not isinstance(result, dict):
+            continue
+        action = str(result.get("action") or result.get("decision") or "").strip().lower()
+        feedback = result.get("message") or result.get("reason")
+        if action == "fail":
+            return {"action": "fail", "message": str(feedback or "Required final check failed")}
+        if action in ("continue", "block") and isinstance(feedback, str) and feedback.strip():
+            if message is None:
+                message = feedback.strip()
+            fail_at_limit = fail_at_limit or result.get("on_limit") == "fail"
+    if message is not None and fail_at_limit:
+        return {"message": message, "on_limit": "fail"}
+    return message
+
