+# ABOUTME: Checks provider and effort forwarding through the real Stop dispatcher.
+# ABOUTME: Exercises the turn gate and plugin policy API together without a model call.
+
+from types import SimpleNamespace
+
+from agent.turn_stop_gates import _pre_turn_stop_nudge
+
+
+def test_stop_gate_forwards_route_through_real_dispatcher(monkeypatch):
+    observed = []
+    monkeypatch.setattr("hermes_cli.lifecycle.has_hook", lambda name: name == "pre_turn_stop")
+
+    def invoke(name, **kwargs):
+        observed.append((name, kwargs))
+        return [{"action": "continue", "message": "finish native check"}]
+
+    monkeypatch.setattr("hermes_cli.plugins.invoke_hook", invoke)
+    agent = SimpleNamespace(
+        session_id="stop-dispatch", platform="cli", provider="custom",
+        requested_provider="custom", model="local/model",
+        _wire_reasoning_config={"effort": "xhigh"},
+    )
+    assert _pre_turn_stop_nudge(agent, "draft", 0) == "finish native check"
+    assert observed[0][0] == "pre_turn_stop"
+    assert observed[0][1]["provider"] == "custom"
+    assert observed[0][1]["reasoning_effort"] == "xhigh"
