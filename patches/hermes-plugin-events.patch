+def get_pre_turn_stop_continue_message(
+    *, session_id: str = "", platform: str = "", model: str = "", reasoning_effort: str = "",
+    provider: str = "", attempt: int = 0, final_response: str = "",
+) -> Optional[str | Dict[str, str]]:
+    """Ask plugins whether a candidate answer needs another agent turn."""
+    results = invoke_hook(
+        "pre_turn_stop", session_id=session_id, platform=platform, model=model,
+        reasoning_effort=reasoning_effort, provider=provider, attempt=attempt, final_response=final_response,
+    )
+    message = None
+    fail_at_limit = False
+    for result in results:
+        if not isinstance(result, dict):
+            continue
+        action = str(result.get("action") or result.get("decision") or "").strip().lower()
+        feedback = result.get("message") or result.get("reason")
+        if action == "fail":
+            return {"action": "fail", "message": str(feedback or "Required final check failed")}
+        if action in ("continue", "block") and isinstance(feedback, str) and feedback.strip():
+            if message is None:
+                message = feedback.strip()
+            fail_at_limit = fail_at_limit or result.get("on_limit") == "fail"
+    if message is not None and fail_at_limit:
+        return {"message": message, "on_limit": "fail"}
+    return message
