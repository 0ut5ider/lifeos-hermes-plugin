--- /dev/null
+++ b/tests/agent/test_prompt_hook_block.py
@@ -0,0 +1,101 @@
+# ABOUTME: Tests prompt hook denial at the turn boundary.
+# ABOUTME: Ensures blocked user text never reaches the provider or saved history.
+
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from run_agent import AIAgent
+
+
+@pytest.mark.parametrize("hook_name", ["pre_llm_call", "pre_prompt_admission"])
+def test_prompt_hook_block_skips_provider_and_user_history(hook_name):
+    with (
+        patch("model_tools.get_tool_definitions", return_value=[]),
+        patch("model_tools.check_toolset_requirements", return_value={}),
+        patch("agent.process_bootstrap.OpenAI"),
+    ):
+        agent = AIAgent(
+            api_key="test-key-1234567890",
+            base_url="https://openrouter.ai/api/v1",
+            quiet_mode=True,
+            skip_context_files=True,
+            skip_memory=True,
+        )
+    agent.client = MagicMock()
+    agent._cached_system_prompt = "You are helpful."
+    agent.compression_enabled = False
+    history = [{"role": "user", "content": "blocked secret"}, {"role": "assistant", "content": "prior answer"}]
+
+    with (
+        patch("hermes_cli.lifecycle.invoke_hook", side_effect=lambda name, **_: [
+            {"action": "block", "message": "Prompt denied by test"},
+        ] if name == hook_name else []),
+        patch.object(agent, "_persist_session") as persist,
+        patch.object(agent, "_save_trajectory"),
+        patch.object(agent, "_cleanup_task_resources"),
+    ):
+        result = agent.run_conversation("blocked secret", conversation_history=history)
+
+    assert result["final_response"] == "Prompt denied by test"
+    assert result["messages"] == history
+    assert result["api_calls"] == 0
+    assert result["turn_exit_reason"] == "prompt_blocked"
+    assert result["completed"] is True
+    assert "current_turn_user_idx" not in result
+    agent.client.chat.completions.create.assert_not_called()
+    persist.assert_not_called()
+
+
+
+def test_prompt_block_does_not_close_existing_user_tail():
+    from agent.conversation_loop import _close_durable_failed_turn
+
+    db = MagicMock()
+    db.latest_conversation_role.return_value = "user"
+    agent = SimpleNamespace(session_id="s1", _session_db=db, _persist_disabled=False)
+    history = [{"role": "user", "content": "earlier incomplete turn"}]
+    result = {"messages": history, "completed": False, "turn_exit_reason": "prompt_blocked"}
+
+    _close_durable_failed_turn(agent, result)
+
+    assert result["messages"] == history
+    db.latest_conversation_role.assert_not_called()
+
