+@pytest.mark.parametrize("failure", ["raise", "timeout"])
+def test_admission_failure_never_persists_prompt(failure, monkeypatch, caplog, request):
+    from hermes_cli.plugins import PluginManager
+    import threading
+    released = threading.Event()
+    request.addfinalizer(released.set)
+    manager = PluginManager()
+    def guard(**kwargs):
+        if failure == "raise":
+            raise RuntimeError("expected admission failure")
+        released.wait(1)
+        return {"action": "allow"}
+    manager._hooks["pre_prompt_admission"] = [guard]
+    monkeypatch.setattr("hermes_cli.plugins._resolve_hook_callback_timeout", lambda: 0.02)
+    with (
+        patch("model_tools.get_tool_definitions", return_value=[]),
+        patch("model_tools.check_toolset_requirements", return_value={}),
+        patch("agent.process_bootstrap.OpenAI"),
+    ):
+        agent = AIAgent(api_key="test-key-1234567890", base_url="http://127.0.0.1:9/v1",
+                        quiet_mode=True, skip_context_files=True, skip_memory=True)
+    agent.client = MagicMock()
+    agent._cached_system_prompt = "Test"
+    agent.compression_enabled = False
+    with (
+        patch("hermes_cli.lifecycle.invoke_hook", side_effect=manager.invoke_hook),
+        patch.object(agent, "_persist_session") as persist,
+        patch.object(agent, "_save_trajectory"),
+        patch.object(agent, "_cleanup_task_resources"),
+    ):
+        result = agent.run_conversation("prompt must not leave this process")
+    assert result["turn_exit_reason"] == "prompt_blocked"
+    assert result["api_calls"] == 0
+    assert result["messages"] == []
+    agent.client.chat.completions.create.assert_not_called()
+    persist.assert_not_called()
+    assert "pre_prompt_admission" in caplog.text
