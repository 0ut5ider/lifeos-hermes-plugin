@@ -0,0 +1,113 @@
+# ABOUTME: Verifies whole-file overwrite protection through a real SSH backend.
+# ABOUTME: Uses a disposable remote directory when an SSH test target is configured.
+
+import hashlib
+import json
+import os
+import shlex
+import subprocess
+from uuid import uuid4
+
+import pytest
+
+from tools.file_tools import clear_file_ops_cache, read_file_tool, write_file_tool
+from tools.environments.local import LocalEnvironment
+from tools.file_operations import ShellFileOperations
+
+
+_SSH_HOST = os.environ.get("HERMES_TEST_SSH_HOST")
+_SSH_USER = os.environ.get("HERMES_TEST_SSH_USER")
+_SSH_KEY = os.environ.get("HERMES_TEST_SSH_KEY")
+_SSH_HOME = os.environ.get("HERMES_TEST_SSH_HOME")
+
+
+def test_backend_digest_distinguishes_file_missing_and_directory(tmp_path):
+    ops = ShellFileOperations(LocalEnvironment(cwd=str(tmp_path)), cwd=str(tmp_path))
+    target = tmp_path / "with spaces.txt"
+    assert ops.file_digest(str(target)) == ("missing", None)
+    target.write_text("first\n")
+    status, first = ops.file_digest(str(target))
+    assert status == "file" and len(first) == 64
+    target.write_text("second\n")
+    assert ops.file_digest(str(target)) == ("file", hashlib.sha256(b"second\n").hexdigest())
+    assert ops.file_digest(str(tmp_path)) == ("not_regular", None)
+
+
+@pytest.mark.skipif(
+    not all((_SSH_HOST, _SSH_USER, _SSH_KEY, _SSH_HOME)),
+    reason="Set HERMES_TEST_SSH_HOST, USER, KEY, and HOME for the live SSH test",
+)
+def test_remote_read_change_write_refuses_and_recovers(tmp_path, monkeypatch):
+    remote_dir = f"{_SSH_HOME}/workspace/hermes-stale-{uuid4().hex}"
+    ssh = ["ssh", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=accept-new",
+           "-i", _SSH_KEY, f"{_SSH_USER}@{_SSH_HOST}"]
+
+    def remote(command):
+        return subprocess.run(ssh + [command], check=True, capture_output=True, text=True).stdout
+
+    profile = tmp_path / ".hermes"
+    profile.mkdir()
+    (profile / "config.yaml").write_text(
+        "terminal:\n  backend: ssh\n"
+        f"  cwd: {json.dumps(remote_dir)}\n"
+        f"  ssh_host: {json.dumps(_SSH_HOST)}\n"
+        f"  ssh_user: {json.dumps(_SSH_USER)}\n"
+        f"  ssh_key: {json.dumps(_SSH_KEY)}\n"
+    )
+    monkeypatch.setenv("HERMES_HOME", str(profile))
+    task = f"remote-stale-{uuid4().hex}"
+    target = f"{remote_dir}/ISA.md"
+    remote(f"mkdir -p {shlex.quote(remote_dir)}")
+    try:
+        remote(f"printf '# Probe\\nold\\n' > {shlex.quote(target)}")
+        read = json.loads(read_file_tool("ISA.md", task_id=task))
+        assert read.get("content") == "1|# Probe\n2|old", read
+
+        remote(f"printf '# Probe\\nexternal edit\\n' > {shlex.quote(target)}")
+        refused = json.loads(write_file_tool(
+            "ISA.md", "# Probe\nold\nmy edit\n", task_id=task))
+        assert refused.get("stale_write_blocked"), refused
+        assert remote(f"cat {shlex.quote(target)}") == "# Probe\nexternal edit\n"
+
+        refreshed = json.loads(read_file_tool("ISA.md", task_id=task))
+        assert "external edit" in refreshed.get("content", ""), refreshed
+        merged = json.loads(write_file_tool(
+            "ISA.md", "# Probe\nexternal edit\nmy edit\n", task_id=task))
+        assert not merged.get("error"), merged
+        assert remote(f"cat {shlex.quote(target)}") == "# Probe\nexternal edit\nmy edit\n"
+
+        mutation = (
+            f"import os; from pathlib import Path; p=Path({target!r}); "
+            "st=p.stat(); p.write_text('# Probe\\nmtime preserved\\n'); "
+            "os.utime(p, ns=(st.st_atime_ns, st.st_mtime_ns))"
+        )
+        remote("python3 -c " + shlex.quote(mutation))
+        same_mtime = json.loads(write_file_tool("ISA.md", "stale again\n", task_id=task))
+        assert same_mtime.get("stale_write_blocked"), same_mtime
+        assert remote(f"cat {shlex.quote(target)}") == "# Probe\nmtime preserved\n"
+
+        unread = json.loads(write_file_tool("ISA.md", "unread\n", task_id=task + "-unread"))
+        assert unread.get("stale_write_blocked"), unread
+        created = json.loads(write_file_tool("NEW.md", "created\n", task_id=task + "-new"))
+        assert not created.get("error"), created
+        assert remote(f"cat {shlex.quote(remote_dir + '/NEW.md')}") == "created\n"
+
+        paged_path = f"{remote_dir}/PAGED.md"
+        remote(f"printf 'one\\ntwo\\nthree\\n' > {shlex.quote(paged_path)}")
+        pages_task = task + "-pages"
+        for offset in (1, 2, 3):
+            page = json.loads(read_file_tool("PAGED.md", offset=offset, limit=1, task_id=pages_task))
+            assert not page.get("error"), page
+        paged = json.loads(write_file_tool("PAGED.md", "merged pages\n", task_id=pages_task))
+        assert not paged.get("error"), paged
+        assert remote(f"cat {shlex.quote(paged_path)}") == "merged pages\n"
+    finally:
+        for suffix in ("", "-unread", "-new", "-pages"):
+            clear_file_ops_cache(task + suffix)
+        from tools import terminal_tool
+        with terminal_tool._env_lock:
+            active = terminal_tool._active_environments.pop("default", None)
+            terminal_tool._last_activity.pop("default", None)
+        if active is not None:
+            active.cleanup()
+        remote(f"rm -rf -- {shlex.quote(remote_dir)}")
