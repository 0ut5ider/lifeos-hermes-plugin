@@ -134,3 +134,68 @@ def test_smart_plugin_grant_does_not_override_tirith(monkeypatch):
         result = check_all_command_guards("rm -rf /tmp/plugin-fixture", "local", approval_callback=decline)
     assert result["approved"] is False
     assert decisions == [True]
+
+
+def test_native_plugin_denial_blocks_recoverable_pattern():
+    with patch("hermes_cli.plugins.invoke_hook", return_value=[{"action": "deny"}]):
+        result = check_dangerous_command(
+            "rm -rf /tmp/lifeos-denial-fixture", "local",
+            approval_callback=lambda *args, **kwargs: pytest.fail("Human prompt was called"),
+        )
+    assert result["approved"] is False
+    assert "plugin" in result["message"].lower()
+
+
+def test_native_plugin_denial_blocks_combined_guard():
+    with patch("hermes_cli.plugins.invoke_hook", return_value=[{"action": "deny"}]), patch(
+        "tools.tirith_security.check_command_security",
+        return_value={"action": "allow", "findings": [], "summary": ""},
+    ):
+        result = check_all_command_guards(
+            "rm -rf /tmp/lifeos-denial-fixture", "local",
+            approval_callback=lambda *args, **kwargs: pytest.fail("Human prompt was called"),
+        )
+    assert result["approved"] is False
+    assert "plugin" in result["message"].lower()
+
+
+def test_installed_command_policy_denial_blocks_without_human_prompt(tmp_path, monkeypatch):
+    from hermes_cli import plugins as plugins_mod
+
+    home = tmp_path / "hermes-home"
+    plugin = home / "plugins" / "command_policy"
+    plugin.mkdir(parents=True)
+    (plugin / "plugin.yaml").write_text(
+        "name: command_policy\nversion: 0.1.0\nprovides_hooks:\n  - pre_command_approval\n"
+    )
+    (plugin / "__init__.py").write_text(
+        "def register(ctx):\n"
+        "    ctx.register_hook(\"pre_command_approval\", lambda **kwargs: {\"action\": \"deny\"})\n"
+    )
+    (home / "config.yaml").write_text("plugins:\n  enabled:\n    - command_policy\n")
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    plugins_mod._reset_plugin_managers_for_tests()
+    try:
+        result = check_dangerous_command(
+            "rm -rf /tmp/lifeos-denial-fixture", "local",
+            approval_callback=lambda *args, **kwargs: pytest.fail("Human prompt was called"),
+        )
+        assert result["approved"] is False
+        assert result["outcome"] == "plugin_denied"
+    finally:
+        plugins_mod._reset_plugin_managers_for_tests()
+
+
+def test_native_plugin_denial_precedes_smart_guardian(monkeypatch):
+    monkeypatch.setattr(approval_context, "_get_approval_mode", lambda: "smart")
+    with patch("hermes_cli.plugins.invoke_hook", return_value=[{"action": "allow"}, {"action": "deny"}]), patch(
+        "tools.tirith_security.check_command_security",
+        return_value={"action": "allow", "findings": [], "summary": ""},
+    ), patch("tools.approval._smart_verdict", return_value="approve") as guardian:
+        result = check_all_command_guards(
+            "rm -rf /tmp/lifeos-denial-fixture", "local",
+            approval_callback=lambda *args, **kwargs: pytest.fail("Human prompt was called"),
+        )
+    assert result["approved"] is False
+    assert result["outcome"] == "plugin_denied"
+    guardian.assert_not_called()
