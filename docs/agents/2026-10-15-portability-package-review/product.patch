@@ -0,0 +1,61 @@
+# ABOUTME: Proves exact guard and Pulse ownership from the installed integration journals.
+# ABOUTME: Refuses changed owner software before complete removal selects any target.
+import re
+from pathlib import Path
+
+from .cli import read_private
+from .release_catalog import ReleaseRejected
+from .release_operation import validate_plan
+from .release_programs import ProgramTransaction,fingerprint
+from .release_stage import validate_files
+
+
+IDENTIFIER=re.compile('[0-9a-f]{32}')
+
+
+def guard(profile, installed, *, bridge):
+    profile,installed=Path(profile).absolute(),Path(installed).absolute()
+    mount=bridge.memory_module('mount_transaction')
+    baseline=bridge.memory_module('version_drift').default_baseline_path(installed.parent)
+    transaction=mount.MountTransaction(installed,profile,baseline)
+    try:manifest=transaction._manifest()
+    except (RuntimeError,OSError,ValueError) as error:
+        raise ReleaseRejected('The current native mount cannot prove guard ownership') from error
+    if manifest is None or manifest['state']!='committed':
+        raise ReleaseRejected('Complete the current native mount before software removal')
+    root=profile/'plugins/lifeos';files={}
+    for entry in manifest['entries']:
+        target=Path(entry['target'])
+        if not target.is_relative_to(root):continue
+        actual=fingerprint(target);expected=entry['after']
+        if actual!={'type':'file','mode':expected['mode'],'sha256':expected['digest']}:
+            raise ReleaseRejected('A native guard changes after its owned mount')
+        files[str(target.relative_to(root))]=expected['digest']
+    if set(files)!={'__init__.py','guard.py','plugin.yaml','policy.json'}:
+        raise ReleaseRejected('The native mount does not prove every guard file')
+    identity=fingerprint(root);validate_files(root,files)
+    if fingerprint(root)!=identity:raise ReleaseRejected('The native guard changes during its exact inventory')
+    return identity
+
+
+def pulse(profile, installed):
+    profile,installed=Path(profile).absolute(),Path(installed).absolute()
+    target=profile.parent/'.config/systemd/user/com.lifeos.pulse.service'
+    identity=fingerprint(target)
+    if identity is None or identity['type']!='file':
+        raise ReleaseRejected('Removal requires the regular integration-owned Pulse definition')
+    root=profile/'.lifeos-releases'
+    if root.resolve()!=root or not root.is_dir():raise ReleaseRejected('The original managed service record is unavailable')
+    for job in sorted(root.iterdir()):
+        if IDENTIFIER.fullmatch(job.name) is None:continue
+        try:
+            request=read_private(job/'request.json');status=read_private(job/'status.json')
+        except FileNotFoundError:continue
+        if status.get('state')!='applied' or request.get('profile')!=str(profile) or request.get('installed')!=str(installed):continue
+        plan=validate_plan(job,request)
+        if plan.get('fresh') is not True:continue
+        programs=ProgramTransaction(job/'program-snapshot',expected_entries_sha256=plan['program_entries_sha256'])
+        entries=programs._load()['entries']
+        if any(entry['target']==str(target) and entry['before'] is None and entry['after']==identity
+                and entry['kind']=='file' for entry in entries):return target
+    raise ReleaseRejected('The managed integration does not prove ownership of this Pulse definition')
diff --git a/optional/lifeos_release_manager/removal_preparation.py b/optional/lifeos_release_manager/removal_preparation.py
new file mode 100644
index 00000000..d202a31a
--- /dev/null
+++ b/optional/lifeos_release_manager/removal_preparation.py
@@ -0,0 +1,211 @@
+# ABOUTME: Prepares a current-state complete removal after an exact verified provider return.
+# ABOUTME: Binds retained recovery sources, stock runtime, fixed software targets, and owner review.
+from pathlib import Path
+
+from .cli import read_private
+from .release_catalog import ReleaseRejected
+
+
+def returned(profile, identifier, signature, *, owner, source, configuration, installation_lease=None):
+    from .memory_workflow import _job
+    profile=Path(profile).absolute()
+    value=configuration.load();configuration.check_owner(value,owner)
+    if value.get('ownership_enabled') is not False:
+        raise ReleaseRejected('Return to built-in memory before complete software removal')
+    job,request=_job(profile,identifier)
+    receipt=read_private(job/'receipt.json');review=read_private(job/'review.json')
+    if (request['owner']!=owner or request['selection']['kind']!='return'
+            or read_private(job/'status.json')['state']!='verified'
+            or receipt.get('state')!='verified' or receipt.get('application_verified') is not True
+            or review.get('signature')!=signature or receipt.get('signature')!=signature):
+        raise ReleaseRejected('Removal requires the exact verified provider-return workflow')
+    transition=source.memory_module('memory_transition').MemoryTransition(configuration,
+        installation_lease=installation_lease,operation_id=identifier)
+    plan,state=transition._load(signature,owner)
+    expected=source.memory_module('memory_import_sources').directory(profile,request['selection']['identifier'])
+    if state!='verified' or plan['snapshot']!=str(expected):
+        raise ReleaseRejected('The verified provider return changes its current operation binding')
+    operation=source.memory_module('memory_return').MemoryReturn(configuration,
+        installation_lease=installation_lease,operation_id=identifier)
+    inner,phase,_=operation._load(expected,plan['return_signature'],owner)
+    if (phase['state']!='configured' or inner['export_signature']!=request['selection']['signature']
+            or inner['export_plan_signature']!=request['selection']['plan_signature']):
+        raise ReleaseRejected('The provider return loses its reviewed export binding')
+    operation._native_current(inner)
+    return {'return_identifier':identifier,'return_signature':signature,'native_signature':inner['target_signature']}
+
+
+def software(profile, installed, generation, native, runtime, generated, *, workspace, pulse):
+    import shlex
+    from .release_programs import publish
+    from .removal_configuration import configuration,environment
+    from .removal_consumers import hooks
+    profile,installed,runtime,generated=map(Path,(profile,installed,runtime,generated))
+    import json
+    hooks(json.loads(native['settings']),profile,installed)
+    directories={profile/'plugins'/name:None for name in ('lifeos','lifeos-hook-bridge','lifeos-release-manager')}
+    files={**native['files'],pulse:None,generation['bun']:None,
+        **{profile/name:None for name in ('lifeos-memory.json','lifeos-installation.json','integration-release.json')}}
+    from .release_programs import fingerprint
+    expected={path:fingerprint(path,allow_links=path in native['dependencies']) for path in (*directories,*files,*native['dependencies'],
+        installed/'settings.json',profile/'config.yaml',profile/'.env',*generation['launchers'])}
+    expected.update(native.get('before',{}));expected.update(generation['launchers'])
+    if 'bun_identity' in generation:expected[generation['bun']]=generation['bun_identity']
+    publish(generated/'settings.json',native['settings']);files[installed/'settings.json']=generated/'settings.json'
+    publish(generated/'config.yaml',configuration(_input(profile/'config.yaml',expected),installed))
+    files[profile/'config.yaml']=generated/'config.yaml'
+    path=profile/'.env'
+    if path.exists() or path.is_symlink():
+        publish(generated/'environment',environment(_input(path,expected),profile,workspace))
+        files[path]=generated/'environment'
+    for path in generation['launchers']:
+        name=path.name if path.name in {'hermes','hermes-agent','hermes-acp'} else 'hermes'
+        target=runtime/'bin'/name
+        publish(generated/name,('#!/bin/sh\nexec '+shlex.quote(str(target))+' "$@"\n').encode(),0o700)
+        files[path]=generated/name
+    if profile/'.env' not in files:expected.pop(profile/'.env')
+    return directories,files,native['dependencies'],expected
+
+
+def _input(path, expected):
+    import hashlib
+    from .release_programs import fingerprint
+    data=path.read_bytes()
+    identity=expected[path]
+    if (identity is None or identity['type']!='file' or hashlib.sha256(data).hexdigest()!=identity['sha256']
+            or fingerprint(path)!=identity):
+        raise ReleaseRejected('A current removal input changes during its transformation')
+    return data
+
+
+def _encoded(value):
+    import json
+    return json.dumps(value,sort_keys=True,separators=(',',':')).encode()
+
+
+def _consumers(profile, installed, services, *, workflow=None):
+    from . import removal_consumers
+    admitted=services._admission()
+    known=set()
+    for role in services.units:
+        values,_=services._inspect(role)
+        known.update([Path(values['FragmentPath']),*map(Path,values['DropInPaths'].split())])
+    coordinator=removal_consumers.coordinator(profile,workflow) if workflow is not None else None
+    groups={item['control_group'] for item in admitted['services'].values() if item['control_group']}
+    if coordinator is not None:
+        known.add(coordinator['fragment']);known.update(coordinator['dropins']);groups.add(coordinator['group'])
+    removal_consumers.unit_files(profile,installed,known=known,coordinator=coordinator)
+    removal_consumers.processes(profile,installed,groups=groups)
+    if workflow is not None and removal_consumers.coordinator(profile,workflow)!=coordinator:
+        raise ReleaseRejected('The admitted removal coordinator changes during consumer inspection')
+
+
+def prepare(profile, job, selected, *, owner, source, configuration, installation_lease=None):
+    import hashlib
+    import shutil
+    from .cli import profile_directory
+    from .release_catalog import _directory
+    from .release_programs import ProgramTransaction,fingerprint,publish
+    from .release_stage import prepare_runtime,runtime_source_fingerprint,sha,validate_files
+    from . import removal_generation,removal_inventory,removal_ownership
+    from .removal_recovery import basic_settings
+    from .removal_services import RemovalServices
+    from .removal_runtime import identity as runtime_identity,launchers
+    if selected.get('disable_discord') is not True:
+        raise ReleaseRejected('Complete removal requires explicit review of Discord disablement')
+    profile=profile_directory(profile);job=_directory(job)
+    if job.parent!=profile/'.lifeos-portability':raise ReleaseRejected('Removal preparation requires its fixed profile workflow')
+    lock=source.memory_module('installation_lock').installation_lock
+    with lock(profile,lease=installation_lease) as lease:
+        binding=returned(profile,selected['identifier'],selected['signature'],owner=owner,
+            source=source,configuration=configuration,installation_lease=lease)
+        policy=configuration.load();installed=Path(policy['root'])
+        generation=removal_generation.selected(profile,installed,bridge=source)
+        settings=basic_settings(profile)
+        if owner!='dashboard:basic:'+settings['username']:
+            raise ReleaseRejected('The current dashboard password account must own standalone removal recovery')
+        root=profile/'.lifeos-releases'
+        for sibling in root.iterdir():
+            if not sibling.is_dir() or not (sibling/'status.json').is_file():continue
+            state=read_private(sibling/'status.json')['state']
+            if state.startswith('queued-') or state in {'preparing','applying','recovering','restoring','recovery_required'}:
+                raise ReleaseRejected('Finish or recover the pending complete release before removal')
+        services=source.memory_module('profile_services').ProfileServices(profile,installed,installation_lease=lease)
+        _consumers(profile,installed,services,workflow=job)
+        removal_ownership.guard(profile,installed,bridge=source)
+        pulse=removal_ownership.pulse(profile,installed)
+        package=generation['package'];dashboard=generation['job']/'download/hermes-dashboard.tgz'
+        if sha(dashboard)!=generation['request']['certificate'].get('hermes_dashboard_sha256'):
+            raise ReleaseRejected('The stock dashboard differs from the qualified release asset')
+        if 'stock_hermes' not in generation['manifest']:
+            raise ReleaseRejected('Install a complete release with qualified stock removal support first')
+        stage=job/'removal';stage.mkdir(mode=0o700)
+        runtime_root=job/'stock-runtime';runtime_root.mkdir(mode=0o700)
+        runtime=prepare_runtime(runtime_root,package,dashboard,profile,stock=True)
+        launchers(runtime_root)
+        for name,files,origin in (('recovery-bridge',generation['bridge_files'],profile/'plugins/lifeos-hook-bridge'),
+                ('recovery-manager',generation['manager_files'],profile/'plugins/lifeos-release-manager')):
+            validate_files(origin,files)
+            shutil.copytree(origin,stage/name,ignore=shutil.ignore_patterns('__pycache__','*.pyc'))
+            validate_files(stage/name,files,forbid_bytecode=True)
+        binding=returned(profile,selected['identifier'],selected['signature'],owner=owner,
+            source=source,configuration=configuration,installation_lease=lease)
+        _consumers(profile,installed,services,workflow=job)
+        guard_identity=removal_ownership.guard(profile,installed,bridge=source)
+        pulse_identity=fingerprint(pulse)
+        if removal_ownership.pulse(profile,installed)!=pulse:
+            raise ReleaseRejected('The current Pulse ownership changes during preparation')
+        native=removal_inventory.native(installed,package/'lifeos/LifeOS/install',
+            Path(generation['request']['runtime']['reference']),bridge=source)
+        workspace=source.memory_module('lifeos_installation').selection(profile).workspace
+        generated=stage/'generated';generated.mkdir(mode=0o700)
+        mount=source.memory_module('mount_transaction')
+        for name in ('config.yaml','.env'):
+            data,metadata=mount._read(profile/name)
+            if data is not None and metadata['mode'] & 0o077:
+                raise ReleaseRejected('The current configuration and environment require private owner permissions')
+        directories,files,dependencies,expected=software(profile,installed,generation,native,runtime_root,generated,
+            workspace=workspace,pulse=pulse)
+        programs=ProgramTransaction(stage/'programs')
+        expected[profile/'plugins/lifeos']=guard_identity;expected[pulse]=pulse_identity
+        for name in ('lifeos-hook-bridge','lifeos-release-manager'):
+            retained=stage/('recovery-bridge' if name=='lifeos-hook-bridge' else 'recovery-manager')
+            expected[profile/'plugins'/name]=fingerprint(retained)
+        programs.prepare(directories=directories,files=files,dependencies=dependencies,expected_before=expected)
+        service_signature=RemovalServices(services,stage/'services.json').prepare(removed=[pulse])
+        policy=configuration.load();configuration.check_owner(policy,owner)
+        encoded_policy=_encoded(policy);publish(stage/'owner-policy.json',encoded_policy)
+        plan={'format':1,'profile':str(profile),'root':str(installed),'identifier':job.name,'owner':owner,
+            'workspace':str(workspace),'bridge_files':generation['bridge_files'],'manager_files':generation['manager_files'],
+            'owner_policy_sha256':hashlib.sha256(encoded_policy).hexdigest(),'program_entries_sha256':programs.entries_digest(),
+            'service_signature':service_signature,'stock_runtime':runtime,'stock_runtime_source':runtime_source_fingerprint(runtime_root/'hermes'),
+            'stock_runtime_manifest_sha256':sha(runtime_root/'manifest.json'),
+            'stock_runtime_execution':runtime_identity(runtime_root),
+            'generation':generation['job'].name,'disable_discord':True,**binding}
+        recovery=_recovery_command(profile,job,runtime)
+        publish(stage/'recover',recovery,0o700)
+        plan['recovery_command_sha256']=hashlib.sha256(recovery).hexdigest()
+        signature=hashlib.sha256(_encoded(plan)).hexdigest()
+        # The helper reads the bound plan signature from the private marker after owner application.
+        publish(stage/'plan.json',_encoded(plan));publish(stage/'operation.json',_encoded({'signature':signature,'state':'ready'}))
+        programs.check_prepared()
+        from .removal_state import prepared
+        prepared(profile,job.name,signature)
+        return {'state':'ready','signature':signature,'kind':'removal','application_verified':False,
+            'native_data_retained':True,'builtin_memory_retained':True,'discord_disabled':True,
+            'stock_commit':runtime['stock_source']['commit'],'stock_patches':0,
+            'program_targets':len(programs._load()['entries']),'recovery_command':str(stage/'recover')}
+
+
+def _recovery_command(profile, job, runtime):
+    import shlex
+    from hermes_cli import _launchers
+    code=Path(__file__).with_name('removal_bootstrap.py').read_text()+('\n'
+        'selected=validate(sys.argv[1],sys.argv[2])\n'
+        'sys.argv=[selected["worker"],*sys.argv[1:],selected["signature"]]\n'
+        'runpy.run_path(selected["worker"],run_name="__main__")\n')
+    command=_launchers.runtime_command(Path(runtime['source']),[str(profile),job.name],
+        code=code,python=runtime['python'])
+    from .removal_runtime import command as stock_command
+    command=stock_command(command,runtime)
+    return ('#!/bin/sh\nexec '+shlex.join(command)+' "$@"\n').encode()
diff --git a/optional/lifeos_release_manager/removal_publication.py b/optional/lifeos_release_manager/removal_publication.py
new file mode 100644
index 00000000..ed6a6968
--- /dev/null
+++ b/optional/lifeos_release_manager/removal_publication.py
@@ -0,0 +1,135 @@
+# ABOUTME: Publishes a reviewed software removal under the owner, native writer, and service barriers.
+# ABOUTME: Resumes interrupted program changes and restores software without rewriting later Hermes memory.
+import json
+from pathlib import Path
+
+from .cli import read_private
+from .release_catalog import ReleaseRejected
+from .release_programs import ProgramTransaction,publish
+from .removal_services import RemovalServices
+from .removal_data import barrier
+from .removal_state import retained
+
+
+STATES={'ready','draining','publishing','restarting','verification_required','verified','restoring','rolled_back'}
+
+
+class RemovalPublication:
+    def __init__(self, profile, signature, *, services=None, installation_lease=None):
+        self.profile=Path(profile).absolute()
+        self.source,self.configuration,self.job,self.plan=retained(self.profile)
+        if self.plan['signature']!=signature:
+            raise ReleaseRejected('Software removal requires the exact reviewed owner signature')
+        for field in ('program_entries_sha256','service_signature','native_signature'):
+            if not isinstance(self.plan.get(field),str) or len(self.plan[field])!=64:
+                raise ReleaseRejected('Software removal has an incomplete publication review')
+        self.signature=signature;self.lease=installation_lease;self.stage=self.job/'removal'
+        self.programs=ProgramTransaction(self.stage/'programs',expected_entries_sha256=self.plan['program_entries_sha256'])
+        controller=self.source.memory_module('profile_services').ProfileServices(self.profile,Path(self.plan['root']),
+            installation_lease=installation_lease) if services is None else None
+        self.services=RemovalServices(controller,self.stage/'services.json') if services is None else services
+        bindings=self.services._load(self.plan['service_signature'])
+        if bindings['profile']!=str(self.profile) or bindings['installed']!=self.plan['root']:
+            raise ReleaseRejected('The removal service barrier belongs to another installation')
+        self.importer=self.source.memory_module('memory_import').MemoryImport(self.configuration)
+        root=Path(self.plan['root'])
+        protected=(root.parent/'.config/LIFEOS/USER',self.profile/'memories',self.profile/'SOUL.md',
+            self.stage,root/'LIFEOS/USER',root/'LIFEOS/MEMORY',self.profile/'workspace',root.parent/'workspace')
+        for entry in self.programs._load()['entries']:
+            target=Path(entry['target'])
+            if any(target.is_relative_to(path) or path.is_relative_to(target) for path in protected):
+                raise ReleaseRejected('Software removal cannot target personal data or its recovery sources')
+
+    def _owner(self, account):
+        if not isinstance(account,str) or account!=self.plan['owner']:
+            raise PermissionError('The authenticated installation owner must authorize software removal')
+        value=self.configuration.load();self.configuration.check_owner(value,account)
+        if value.get('ownership_enabled') is not False or value['root']!=self.plan['root']:
+            raise ReleaseRejected('Verify provider return before software removal')
+
+    def _load(self):
+        value=read_private(self.stage/'operation.json')
+        if (not isinstance(value,dict) or set(value)!={'signature','state'} or value['signature']!=self.signature
+                or value['state'] not in STATES):
+            raise ReleaseRejected('The removal publication journal has invalid owner state')
+        return value['state']
+
+    def _state(self, state):
+        publish(self.stage/'operation.json',json.dumps({'signature':self.signature,'state':state},sort_keys=True).encode())
+
+    def _receipt(self, state):
+        return {'state':state,'signature':self.signature,'native_data_retained':True,'builtin_memory_retained':True,
+            'application_verified':state=='verified'}
+
+    def apply(self, *, account, checkpoint=lambda point:None):
+        lock=self.source.memory_module('installation_lock').installation_lock
+        program_lock=self.source.memory_module('program_lock')
+        with lock(self.profile,lease=self.lease),program_lock.exclusive(self.profile,600):
+            self._owner(account);state=self._load()
+            if state in {'restoring','rolled_back'}:raise ReleaseRejected('Recover the reviewed software rollback before removal')
+            if state in {'verification_required','verified'}:
+                self.programs.check_applied();self.services.verify(self.plan['service_signature'])
+                return self._receipt(state)
+            if state=='ready':self.programs.check_prepared()
+            else:self.programs.check_recovery()
+            self._state('draining');self.services.stop(self.plan['service_signature']);checkpoint('drained')
+            with self.configuration._lock(),barrier(self.importer.memory) as connection:
+                self._owner(account)
+                if self.importer._target_signature(connection)!=self.plan['native_signature']:
+                    raise ReleaseRejected('Native facts change after the reviewed reverse export')
+                self.services.verify_stopped(self.plan['service_signature'])
+                self._state('publishing');self.programs.resume(checkpoint=checkpoint)
+                self.programs.check_applied();checkpoint('programs-published')
+                self._owner(account)
+                if self.importer._target_signature(connection)!=self.plan['native_signature']:
+                    raise ReleaseRejected('Native data changes during software removal')
+                self._state('restarting');self.services.resume(self.plan['service_signature']);checkpoint('restarted')
+                self._state('verification_required')
+            return self._receipt('verification_required')
+
+    def rollback(self, *, account, checkpoint=lambda point:None):
+        lock=self.source.memory_module('installation_lock').installation_lock
+        program_lock=self.source.memory_module('program_lock')
+        with lock(self.profile,lease=self.lease),program_lock.exclusive(self.profile,600):
+            self._owner(account);state=self._load()
+            if state=='rolled_back':return self._receipt(state)
+            self.programs.check_recovery()
+            self._state('restoring');self.services.stop(self.plan['service_signature']);checkpoint('drained')
+            with self.configuration._lock(),barrier(self.importer.memory):
+                self._owner(account);self.services.verify_stopped(self.plan['service_signature'])
+                self.programs.restore();checkpoint('programs-restored')
+                self._owner(account);self.services.resume(self.plan['service_signature'],restored=True)
+                self._state('rolled_back')
+            return self._receipt('rolled_back')
+
+    def verify(self, probe, *, account):
+        if not callable(probe):raise ValueError('Removal requires an actual fresh stock agent verifier')
+        lock=self.source.memory_module('installation_lock').installation_lock
+        program_lock=self.source.memory_module('program_lock')
+        with lock(self.profile,lease=self.lease),program_lock.exclusive(self.profile,600):
+            self._owner(account)
+            if self._load() not in {'verification_required','verified'}:
+                raise ReleaseRejected('Finish software publication and service restart before final verification')
+            self.programs.check_applied();self.services.verify(self.plan['service_signature'])
+            read=self.source.memory_module('mount_transaction')._read
+            names=('config.yaml','SOUL.md','lifeos-memory.json','memories/MEMORY.md','memories/USER.md')
+            captured={name:read(self.profile/name) for name in names}
+            expected={name:captured['memories/'+name][0].decode() for name in ('MEMORY.md','USER.md')}
+            with barrier(self.importer.memory) as connection:
+                if self.importer._target_signature(connection)!=self.plan['native_signature']:
+                    raise ReleaseRejected('Native facts change before final software removal verification')
+                proof=probe(expected)
+            if (not isinstance(proof,dict) or proof.get('format')!=1 or proof.get('provider')!='builtin'
+                    or proof.get('fresh_agent_verified') is not True or proof.get('model_turn_executed') is not False
+                    or proof.get('profile')!=str(self.profile)
+                    or proof.get('files')!={name:metadata for name,(_,metadata) in captured.items()}
+                    or not isinstance(proof.get('active_plugins'),list)
+                    or {'lifeos','lifeos-hook-bridge','lifeos-release-manager'} & set(proof['active_plugins'])
+                    or proof.get('native_providers')):
+                raise ReleaseRejected('The fresh stock agent does not prove complete removal and retained built-in memory')
+            if any(read(self.profile/name)!=captured[name] for name in names):
+                raise ReleaseRejected('The retained Hermes files change during final removal verification')
+            self._owner(account);self.programs.check_applied();self.services.verify(self.plan['service_signature'])
+            publish(self.stage/'fresh-agent-verification.json',json.dumps(proof,sort_keys=True).encode())
+            self._state('verified')
+            return {**self._receipt('verified'),'verification':proof}
