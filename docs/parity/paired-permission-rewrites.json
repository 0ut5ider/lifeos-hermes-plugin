        "original_exists": {"native": "original_exists", "hermes": "original_exists", "expected": false},
        "written_content": {"native": "rewritten_content", "hermes": "rewritten_content", "expected": "MODIFIED"}
      }
    },
    {
      "id": "mcp-argument-replacement",
      "native": "../agents/2026-09-28-native-contract-probe/mcp-rewrite.jsonl",
