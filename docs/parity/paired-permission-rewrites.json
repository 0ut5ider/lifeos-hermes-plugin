      "fields": {
        "effective_command": {"native": "post_tool_input.command", "hermes": "effective_command", "expected": "pwd"},
        "original_exists": {"native": "original_exists", "hermes": "original_exists", "expected": false}
      }
    },
    {
      "id": "write-path-and-content-replacement",
