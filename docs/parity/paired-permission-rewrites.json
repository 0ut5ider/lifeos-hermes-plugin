      "fields": {
        "effective_value": {"native": "post_tool_input.value", "hermes": "effective_args.value", "expected": "MODIFIED"},
        "server_calls": {"native": "server_calls", "hermes": "server_calls", "expected": [{"value": "MODIFIED"}]}
      }
    }
  ]
