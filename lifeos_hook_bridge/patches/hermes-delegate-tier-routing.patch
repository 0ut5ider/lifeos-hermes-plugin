+# ABOUTME: Checks that a delegated child receives its own model and reasoning effort.
+# ABOUTME: Rejects malformed routes before constructing any child.
+
+import unittest
+from pathlib import Path
+from tempfile import TemporaryDirectory
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+from tools.delegate_tool import DELEGATE_TASK_SCHEMA, _build_child_agent, _build_children, _task_model_route
+
+
+class DelegateTierRouteTests(unittest.TestCase):
+    def test_model_facing_schema_exposes_child_route(self):
+        fields = DELEGATE_TASK_SCHEMA["parameters"]["properties"]["tasks"]["items"]["properties"]
+        self.assertIn("model", fields)
+        self.assertIn("reasoning_effort", fields)
+
+    def test_child_routes_use_per_task_model_and_effort(self):
+        tasks = [
+            {"goal": "first", "model": "local-fast", "reasoning_effort": "low"},
+            {"goal": "second", "model": "local-large", "reasoning_effort": "xhigh"},
+        ]
+        creds = {"model": "default-local", "provider": None, "base_url": None,
+                 "api_key": None, "api_mode": None, "request_overrides": None,
+                 "command": None, "args": None}
+        with patch("tools.delegate_tool._build_child_preserving_parent_tools",
+                   side_effect=lambda **kwargs: SimpleNamespace()) as builder:
+            children, error = _build_children(
+                tasks, [None, None], creds, top_role="leaf", max_iterations=3,
+                parent_agent=SimpleNamespace(), routing_cfg={}, live_deleg_id=None, live_writers=[],
+            )
+        self.assertIsNone(error)
+        self.assertEqual(len(children), 2)
+        self.assertEqual([call.kwargs["model"] for call in builder.call_args_list],
+                         ["local-fast", "local-large"])
+        self.assertEqual([call.kwargs["reasoning_config_override"] for call in builder.call_args_list],
+                         [{"enabled": True, "effort": "low"}, {"enabled": True, "effort": "xhigh"}])
+
+    def test_invalid_route_prevents_all_children(self):
+        creds = {"model": "default-local", "provider": None, "base_url": None,
+                 "api_key": None, "api_mode": None, "request_overrides": None,
+                 "command": None, "args": None}
+        with patch("tools.delegate_tool._build_child_preserving_parent_tools") as builder:
+            children, error = _build_children(
+                [{"goal": "first"}, {"goal": "second", "reasoning_effort": "extreme"}],
+                [None, None], creds, top_role="leaf", max_iterations=3,
+                parent_agent=SimpleNamespace(), routing_cfg={}, live_deleg_id=None, live_writers=[],
+            )
+        self.assertEqual(children, [])
+        self.assertIn("reasoning_effort", error)
+        builder.assert_not_called()
+
+    def test_empty_model_inherits_configured_route(self):
+        self.assertEqual(_task_model_route({"model": "", "reasoning_effort": "medium"}, "default-local"),
+                         ("default-local", {"enabled": True, "effort": "medium"}))
+
+    def test_child_constructor_receives_model_and_effort(self):
+        parent = MagicMock()
+        parent.base_url = "https://openrouter.ai/api/v1"
+        parent.api_key = "test-only"
+        parent.provider = "openrouter"
+        parent.api_mode = "chat_completions"
+        parent.model = "default-local"
+        parent.platform = "cli"
+        parent._delegate_depth = 0
+        parent._session_db = None
+        parent.enabled_toolsets = ["file"]
+        parent.disabled_toolsets = []
+        parent.reasoning_config = {"enabled": True, "effort": "medium"}
+        with patch("run_agent.AIAgent") as agent:
+            _build_child_agent(
+                task_index=0, goal="inspect", context=None, toolsets=["file"], model="large-local",
+                reasoning_config_override={"enabled": True, "effort": "xhigh"},
+                max_iterations=3, task_count=1, parent_agent=parent,
+            )
+        self.assertEqual(agent.call_args.kwargs["model"], "large-local")
+        self.assertEqual(agent.call_args.kwargs["reasoning_config"], {"enabled": True, "effort": "xhigh"})
+
+    def test_real_child_keeps_selected_model_and_effort(self):
+        from run_agent import AIAgent
+        with TemporaryDirectory(prefix="delegate-tier-home-") as directory:
+            Path(directory, "config.yaml").write_text("model:\n  default: default-local\n")
+            with patch.dict("os.environ", {"HERMES_HOME": directory}):
+                kwargs = dict(api_key="test-only", base_url="https://openrouter.ai/api/v1",
+                              provider="openrouter", api_mode="chat_completions", model="default-local",
+                              platform="cli", quiet_mode=True, skip_context_files=True, skip_memory=True,
+                              save_trajectories=False, enabled_toolsets=["file"])
+                parent = AIAgent(session_id="tier-parent", **kwargs)
+                child = _build_child_agent(
+                    task_index=0, goal="inspect", context=None, toolsets=["file"],
+                    model="large-local", reasoning_config_override={"enabled": True, "effort": "xhigh"},
+                    max_iterations=3, task_count=1, parent_agent=parent,
+                )
+                try:
+                    self.assertEqual(child.model, "large-local")
+                    self.assertEqual(child.reasoning_config, {"enabled": True, "effort": "xhigh"})
+                    self.assertEqual(parent.model, "default-local")
+                finally:
+                    child.close()
+                    parent.close()
+
+
+if __name__ == "__main__":
+    unittest.main()
