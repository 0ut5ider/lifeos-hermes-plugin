+def _task_model_route(task: Dict[str, Any], default_model: Optional[str]) -> tuple[Optional[str], Optional[Dict[str, Any]]]:
+    """Validate one model-facing child route before any child is constructed."""
+    model = task.get("model")
+    if model is not None and (not isinstance(model, str) or "\n" in model or "\r" in model):
+        raise ValueError("delegate_task model must be one model name on one line")
+    effort = task.get("reasoning_effort")
+    reasoning = None
+    if effort is not None:
+        from hermes_constants import parse_reasoning_effort
+        if not isinstance(effort, str) or not effort.strip():
+            raise ValueError("delegate_task reasoning_effort is not a supported level")
+        reasoning = parse_reasoning_effort(effort)
+        if reasoning is None:
+            raise ValueError("delegate_task reasoning_effort is not a supported level")
+    return (model.strip() if model and model.strip() else default_model), reasoning
+
