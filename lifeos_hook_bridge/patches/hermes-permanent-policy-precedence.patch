+def test_plugin_deny_precedes_permanent_command_allowlist():
+    command = "curl -I http://192.168.8.1:9"
+    with patch("tools.approval._command_matches_permanent_allowlist", return_value=True), patch(
+        "hermes_cli.plugins.invoke_hook", return_value=[{"action": "deny"}],
+    ) as hooks:
+        result = check_all_command_guards(command, "local")
+    assert result["approved"] is False
+    assert result["outcome"] == "plugin_denied"
+    assert any(call.args[0] == "pre_command_approval" for call in hooks.call_args_list)
