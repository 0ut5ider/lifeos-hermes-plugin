@@ -331,3 +331,74 @@ def test_plugin_deny_after_session_review_still_blocks():
         clear_session(session_key)
         from tools import approval_context
         approval_context._approval_session_key.reset(token)
+
+
+def test_plugin_command_policy_receives_target_workspace():
+    calls = []
+
+    def capture(name, **kwargs):
+        if name == "pre_command_approval":
+            calls.append(kwargs)
+        return [{"action": "review"}] if name == "pre_command_approval" else []
+
+    with patch("hermes_cli.plugins.invoke_hook", side_effect=capture):
+        result = check_all_command_guards(
+            "curl -I http://192.168.8.1:9", "docker", has_host_access=False,
+            cwd="/workspace/project-a", task_id="docker-session-a",
+            approval_callback=lambda *args, **kwargs: "deny",
+        )
+    assert result["approved"] is False
+    assert len(calls) == 1
+    assert calls[0]["cwd"] == "/workspace/project-a"
+    assert calls[0]["task_id"] == "docker-session-a"
+    assert calls[0]["env_type"] == "docker"
+
+
+def test_terminal_approval_forwards_target_workspace():
+    from tools import terminal_tool as terminal_module
+
+    with patch.object(terminal_module, "_check_all_guards_impl", return_value={"approved": True}) as guard:
+        terminal_module._check_all_guards(
+            "curl -I http://192.168.8.1:9", "docker", has_host_access=False,
+            cwd="/workspace/project-a", task_id="docker-session-a",
+        )
+    assert guard.call_args.kwargs["cwd"] == "/workspace/project-a"
+    assert guard.call_args.kwargs["task_id"] == "docker-session-a"
+
+    with patch.object(terminal_module, "_check_all_guards", return_value={"approved": True}) as guard:
+        terminal_module._run_approval_guards(
+            "curl -I http://192.168.8.1:9", "docker", {"env_type": "docker"}, force=False,
+            cwd="/workspace/project-a", task_id="docker-session-a",
+        )
+    assert guard.call_args.kwargs["cwd"] == "/workspace/project-a"
+    assert guard.call_args.kwargs["task_id"] == "docker-session-a"
+
+
+def test_prepared_command_policy_is_bound_to_workspace():
+    from types import SimpleNamespace
+    from agent import terminal_approval_batch as batch_module
+    from tools.approval_context import _approval_tool_call_id
+
+    command = "curl -I http://192.168.8.1:9"
+    decision = {"approved": True}
+    slot = SimpleNamespace(
+        preparing=False, check_cancelled=lambda: None,
+        batch=SimpleNamespace(failure_seen=False, task_id="docker-session-a"),
+        parsed=SimpleNamespace(ref=lambda task_id: SimpleNamespace(call_id="call-a")),
+        guard_key=(command, "docker", False, "/workspace/project-a", "docker-session-a"),
+        decision=decision,
+    )
+    slot_token = batch_module._slot.set(slot)
+    call_token = _approval_tool_call_id.set("call-a")
+    try:
+        assert batch_module.consume_prepared_guard(
+            command, "docker", False, "/workspace/project-b", "docker-session-a",
+        ) is None
+        assert slot.decision is decision
+        assert batch_module.consume_prepared_guard(
+            command, "docker", False, "/workspace/project-a", "docker-session-a",
+        ) is decision
+        assert slot.decision is None
+    finally:
+        _approval_tool_call_id.reset(call_token)
+        batch_module._slot.reset(slot_token)
