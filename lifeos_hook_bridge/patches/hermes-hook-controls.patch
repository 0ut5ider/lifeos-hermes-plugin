@@ -0,0 +1,61 @@
+# ABOUTME: Tests prompt hook denial at the turn boundary.
+# ABOUTME: Ensures blocked user text never reaches the provider or saved history.
+
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+from run_agent import AIAgent
+
+
+def test_prompt_hook_block_skips_provider_and_user_history():
+    with (
+        patch("model_tools.get_tool_definitions", return_value=[]),
+        patch("model_tools.check_toolset_requirements", return_value={}),
+        patch("agent.process_bootstrap.OpenAI"),
+    ):
+        agent = AIAgent(
+            api_key="test-key-1234567890",
+            base_url="https://openrouter.ai/api/v1",
+            quiet_mode=True,
+            skip_context_files=True,
+            skip_memory=True,
+        )
+    agent.client = MagicMock()
+    agent._cached_system_prompt = "You are helpful."
+    agent.compression_enabled = False
+    history = [{"role": "user", "content": "blocked secret"}, {"role": "assistant", "content": "prior answer"}]
+
+    with (
+        patch("hermes_cli.lifecycle.invoke_hook", side_effect=lambda name, **_: [
+            {"action": "block", "message": "Prompt denied by test"},
+        ] if name == "pre_llm_call" else []),
+        patch.object(agent, "_persist_session") as persist,
+        patch.object(agent, "_save_trajectory"),
+        patch.object(agent, "_cleanup_task_resources"),
+    ):
+        result = agent.run_conversation("blocked secret", conversation_history=history)
+
+    assert result["final_response"] == "Prompt denied by test"
+    assert result["messages"] == history
+    assert result["api_calls"] == 0
+    assert result["turn_exit_reason"] == "prompt_blocked"
+    assert result["completed"] is True
+    assert "current_turn_user_idx" not in result
+    agent.client.chat.completions.create.assert_not_called()
+    persist.assert_not_called()
+
+
+
+def test_prompt_block_does_not_close_existing_user_tail():
+    from agent.conversation_loop import _close_durable_failed_turn
+
+    db = MagicMock()
+    db.latest_conversation_role.return_value = "user"
+    agent = SimpleNamespace(session_id="s1", _session_db=db, _persist_disabled=False)
+    history = [{"role": "user", "content": "earlier incomplete turn"}]
+    result = {"messages": history, "completed": False, "turn_exit_reason": "prompt_blocked"}
+
+    _close_durable_failed_turn(agent, result)
+
+    assert result["messages"] == history
+    db.latest_conversation_role.assert_not_called()
diff --git a/tests/agent/test_tool_result_context_hook.py b/tests/agent/test_tool_result_context_hook.py
new file mode 100644
index 000000000..c2dea9efe
--- /dev/null
+++ b/tests/agent/test_tool_result_context_hook.py
@@ -0,0 +1,40 @@
+"""A plugin can append context after another plugin transforms a tool result."""
+
+from model_tools import _CallIds, _apply_transform_tool_result_hook
+
+
+def test_augment_result_runs_after_first_transform(monkeypatch):
+    seen = []
+
+    def has_hook(name):
+        return name in {"transform_tool_result", "augment_tool_result"}
+
+    def invoke_hook(name, **kwargs):
+        seen.append((name, kwargs))
+        if name == "transform_tool_result":
+            return ["guarded result", "ignored replacement"]
+        if name == "augment_tool_result":
+            return ["LifeOS context"]
+        return []
+
+    monkeypatch.setattr("hermes_cli.lifecycle.has_hook", has_hook)
+    monkeypatch.setattr("hermes_cli.lifecycle.invoke_hook", invoke_hook)
+
+    result = _apply_transform_tool_result_hook("web_search", {"query": "test"}, "raw result", 3, _CallIds(session_id="s1"))
+    assert result == "guarded result\n\nLifeOS context"
+    assert seen[1][1]["result"] == "guarded result"
+    assert seen[1][1]["original_result"] == "raw result"
+
+
+def test_augment_receives_tool_error(monkeypatch):
+    seen = {}
+    monkeypatch.setattr("hermes_cli.lifecycle.has_hook", lambda name: name == "augment_tool_result")
+
+    def capture(name, **kwargs):
+        seen.update(kwargs)
+        return []
+
+    monkeypatch.setattr("hermes_cli.lifecycle.invoke_hook", capture)
+    _apply_transform_tool_result_hook("terminal", {"command": "false"}, "{\"error\":\"failed\"}", 2, _CallIds(session_id="s2"))
+    assert seen["status"] == "error"
+    assert seen["error_message"] == "failed"
