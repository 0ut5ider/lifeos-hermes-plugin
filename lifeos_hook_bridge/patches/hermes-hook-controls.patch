+"""Keep nested execute_code tool hooks in the outer Hermes session."""
+
+import json
+import os
+import unittest
+from unittest.mock import patch
+
+os.environ["TERMINAL_ENV"] = "local"
+
+from tools.code_execution_tool import _execute_code_handler, _execute_remote, execute_code
+from tools.code_execution_rpc import _default_dispatch
+from tools.code_kernel import shutdown_all_kernels
+
+
+class ExecuteCodeHookSessionTests(unittest.TestCase):
+    def tearDown(self):
+        shutdown_all_kernels()
+
+    def test_handler_passes_outer_session_to_execute_code(self):
+        with patch("tools.code_execution_tool.execute_code", return_value="ok") as call:
+            self.assertEqual(_execute_code_handler({"code": "print(1)"}, task_id="task", session_id="session"), "ok")
+        self.assertEqual(call.call_args.kwargs["session_id"], "session")
+
+    def test_rpc_dispatch_passes_outer_session_to_inner_tool(self):
+        calls = []
+        with patch("model_tools.handle_function_call", side_effect=lambda *args, **kwargs: calls.append(kwargs)):
+            _default_dispatch("task", session_id="session")("read_file", {"path": "note"})
+        self.assertEqual(calls, [{"task_id": "task", "session_id": "session"}])
+
+    def test_remote_fallback_passes_outer_session_to_per_call_rpc(self):
+        class RemoteEnv:
+            def execute(self, *args, **kwargs):
+                return {"output": "OK\n", "returncode": 0}
+
+        with patch("tools.code_execution_tool._load_config", return_value={"timeout": 30, "max_tool_calls": 5}), patch(
+            "tools.code_execution_tool._sandbox_tools_for", return_value={"read_file"}
+        ), patch(
+            "tools.code_execution_tool._get_or_create_env", return_value=(RemoteEnv(), "ssh")
+        ), patch(
+            "tools.code_kernel_remote.execute_in_remote_kernel", return_value=None
+        ) as kernel, patch(
+            "tools.code_execution_tool._run_remote_per_call", return_value="fallback-ok"
+        ) as fallback:
+            result = _execute_remote("print(1)", "task", ["read_file"], session_id="remote-session")
+        self.assertEqual(result, "fallback-ok")
+        self.assertEqual(kernel.call_args.kwargs["session_id"], "remote-session")
+        self.assertEqual(fallback.call_args.kwargs["session_id"], "remote-session")
+
+    def test_local_kernel_uses_each_cells_session_for_inner_tools(self):
+        calls = []
+
+        def record(name, args, **kwargs):
+            calls.append(kwargs)
+            return json.dumps({"ok": True})
+
+        code = "import hermes_tools\nhermes_tools.web_search(query='fixture')\n"
+        with patch("tools.code_execution_tool._load_config", return_value={"mode": "strict", "timeout": 30}), patch(
+            "model_tools.handle_function_call", side_effect=record
+        ):
+            first = json.loads(execute_code(code, task_id="task", session_id="session-one"))
+            second = json.loads(execute_code(code, task_id="task", session_id="session-two"))
+        self.assertEqual(first["status"], "success", first)
+        self.assertEqual(second["status"], "success", second)
+        self.assertEqual([call["session_id"] for call in calls], ["session-one", "session-two"])
+
+
+if __name__ == "__main__":
+    unittest.main()
