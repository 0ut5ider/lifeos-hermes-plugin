diff --git a/agent/auxiliary_recovery.py b/agent/auxiliary_recovery.py
new file mode 100644
index 000000000..48186fb5b
--- /dev/null
+++ b/agent/auxiliary_recovery.py
@@ -0,0 +1,23 @@
+# ABOUTME: Constructs the native auxiliary recovery ladder with an explicit provider fallback policy.
+# ABOUTME: Keeps credential recovery active when a caller forbids a different provider.
+from __future__ import annotations
+from typing import Any, Optional, TYPE_CHECKING
+if TYPE_CHECKING:
+    from agent.auxiliary_client import _PreparedAuxRequest
+
+def _start_recovery_ladder(
+    first_err: Exception, req: _PreparedAuxRequest, retry_kwargs: dict[str, Any], *,
+    task: Optional[str], async_mode: bool, route_info: Optional[dict[str, str]],
+    allow_provider_fallback: bool = True,
+):
+    """Build the recovery-ladder generator for a failed primary request."""
+    from agent.auxiliary_client import _aux_recovery_ladder
+    return _aux_recovery_ladder(
+        first_err, client=req.client, kwargs=req.kwargs, task=task, async_mode=async_mode,
+        base_info=req.base_info, resolved_provider=req.resolved_provider,
+        resolved_model=req.resolved_model, resolved_base_url=req.resolved_base_url,
+        resolved_api_key=req.resolved_api_key, resolved_api_mode=req.resolved_api_mode,
+        final_model=req.final_model, max_tokens=retry_kwargs["max_tokens"],
+        main_runtime=retry_kwargs["main_runtime"], route_info=route_info,
+        allow_provider_fallback=allow_provider_fallback)
+
diff --git a/tests/test_lifeos_aux_no_fallback.py b/tests/test_lifeos_aux_no_fallback.py
new file mode 100644
index 000000000..836728ed8
--- /dev/null
+++ b/tests/test_lifeos_aux_no_fallback.py
@@ -0,0 +1,40 @@
+# ABOUTME: Verifies a selected LifeOS provider cannot fall back to another provider.
+# ABOUTME: Uses a failing local HTTP endpoint and checks the recovery boundary.
+
+import threading
+import unittest
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from unittest.mock import patch
+
+from agent.auxiliary_client import call_llm
+
+
+class LifeOSAuxNoFallbackTests(unittest.TestCase):
+    def test_explicit_route_stops_before_provider_fallback(self):
+        class Endpoint(BaseHTTPRequestHandler):
+            def do_POST(self):
+                self.send_response(503)
+                self.send_header("Content-Type", "application/json")
+                self.end_headers()
+                self.wfile.write(b'{"error":{"message":"unavailable"}}')
+
+            def log_message(self, *_args):
+                pass
+
+        server = ThreadingHTTPServer(("127.0.0.1", 0), Endpoint)
+        thread = threading.Thread(target=server.serve_forever, daemon=True)
+        thread.start()
+        self.addCleanup(server.server_close)
+        self.addCleanup(server.shutdown)
+        with patch("agent.auxiliary_client._ladder_provider_fallback") as fallback:
+            with self.assertRaises(Exception) as caught:
+                call_llm(provider="custom", model="test-model",
+                         base_url=f"http://127.0.0.1:{server.server_port}/v1",
+                         api_key="test-only", messages=[{"role": "user", "content": "hi"}],
+                         max_tokens=8, timeout=2, allow_provider_fallback=False)
+            self.assertNotIsInstance(caught.exception, TypeError)
+            fallback.assert_not_called()
+
+
+if __name__ == "__main__":
+    unittest.main()
