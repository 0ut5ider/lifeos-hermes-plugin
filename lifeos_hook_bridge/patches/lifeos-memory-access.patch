+
+function financeDecodedText(value: unknown): string {
+  const serialized = JSON.stringify(value);
+  if (typeof serialized !== "string") throw new Error("Finance sources require serializable values");
+  const strings: string[] = [];
+  const pending: unknown[] = [value];
+  let count = 0;
+  while (pending.length) {
+    if (++count > 10000) throw new Error("Finance values exceed their projection limit");
+    const item = pending.pop();
+    if (typeof item === "string") strings.push(item);
+    else if (Array.isArray(item)) pending.push(...item);
+    else if (item !== null && typeof item === "object") {
+      for (const [key, entry] of Object.entries(item)) pending.push(key, entry);
+    }
+  }
+  return [serialized, ...strings].join("\n");
+}
+
+export function financeSourceProjections(sources: ReadonlyArray<{relative: string; content: string}>): Array<string | null> {
+  const allowed = new Set(["LIFEOS/USER/FINANCES/vendors.yaml", "LIFEOS/USER/FINANCES/obligations.yaml",
+    "LIFEOS/USER/CONFIG/LIFEOS_CONFIG.toml"]);
+  if (sources.length > allowed.size || sources.some(source => !allowed.has(source.relative))
+      || new Set(sources.map(source => source.relative)).size !== sources.length) throw new Error("Choose fixed finance projections");
+  return sources.map(source => {
+    try {
+      const value: unknown = source.relative.endsWith(".toml") ? Bun.TOML.parse(source.content) : YAML.parse(source.content);
+      return financeDecodedText(value);
+    } catch { return null; }
+  });
+}
