+    if (path !== statePath && !allowed.has(path.slice(dirname(LIFEOS_DIR).length + 1))) {
+      throw new Error("TELOS overviews require fixed owner sources");
+    }
+    return contents.get(path) ?? "";
+  };
+  const exists = (path: string): boolean => path === join(TELOS_DIR, "IDEAL_STATE")
+    ? sources.some(source => source.relative.startsWith("LIFEOS/USER/TELOS/IDEAL_STATE/"))
+    : contents.has(path);
+  return handleTelosOverview(read, exists, true);
+}
