+}
+
+function validHTTPResponse(value: unknown): value is MemoryHTTPResponse {
+  return memoryObject(value)
+    && typeof value.status === "number" && [200, 400, 401, 403, 404, 409, 503].includes(value.status)
+    && typeof value.body === "string" && Array.isArray(value.headers)
+    && value.headers.every(header => Array.isArray(header) && header.length === 2
+      && typeof header[0] === "string" && typeof header[1] === "string"
+      && ["content-type", "cache-control", "set-cookie"].includes(header[0]));
+}
+
+function memoryHTTP(arguments_: Record<string, unknown>): Response {
+  const response = memoryAccess("pulse_http", arguments_, validHTTPResponse);
+  if (response === undefined) throw new Error("Authenticated memory is unavailable");
+  return renderHTTPResponse(response);
+}
+
+function renderHTTPResponse(response: MemoryHTTPResponse): Response {
+  const headers = new Headers();
+  for (const header of response.headers) headers.append(header[0], header[1]);
+  headers.set("cache-control", "no-store");
+  return new Response(response.body, {status: response.status, headers});
+}
+
+export async function memoryHTTPResponseAsync(request: Request, view: string, target?: string, observation?: Record<string, unknown>): Promise<Response> {
+  const command = memoryServiceCommand();
+  const arguments_ = {view, authorization: request.headers.get("authorization") ?? "",
+    cookie: request.headers.get("cookie") ?? "", ...(target === undefined ? {} : {target}),
+    ...(observation === undefined ? {} : {observation})};
+  const result = await new Promise<string>((resolveResult, rejectResult) => {
+    const child = spawn(command.executable, command.arguments, {env: {...process.env},
+      stdio: "pipe", signal: request.signal});
+    let output = "";
+    let bytes = 0;
+    let finished = false;
+    const fail = (): void => {
+      if (finished) return;
+      finished = true;
+      clearTimeout(timeout);
+      child.kill("SIGKILL");
+      rejectResult(new Error("The native memory service is unavailable"));
+    };
+    const timeout = setTimeout(fail, 40_000);
+    child.stdout.setEncoding("utf8");
+    child.stderr.setEncoding("utf8");
+    child.stdout.on("data", (chunk: string) => {
+      if (finished) return;
+      bytes += Buffer.byteLength(chunk);
+      if (bytes > 4 * 1024 * 1024) { fail(); return; }
+      output += chunk;
+    });
+    child.stderr.on("data", (chunk: string) => {
+      bytes += Buffer.byteLength(chunk);
+      if (bytes > 4 * 1024 * 1024) fail();
+    });
+    child.on("error", fail);
+    child.stdin.on("error", fail);
+    child.on("close", (code) => {
+      if (finished) return;
+      if (code !== 0) { fail(); return; }
+      finished = true;
+      clearTimeout(timeout);
+      resolveResult(output);
+    });
+    child.stdin.end(JSON.stringify({operation: "pulse_http", arguments: arguments_}));
+  });
+  const response: unknown = JSON.parse(result);
+  if (!validHTTPResponse(response)) throw new Error("The native memory service returned an invalid result");
+  return renderHTTPResponse(response);
+}
