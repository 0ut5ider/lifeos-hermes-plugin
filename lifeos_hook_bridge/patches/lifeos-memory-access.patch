+let managedHTTP = false;
+
+// ABOUTME: Resolves managed HTTP mode independently from ambient agent context.
+// ABOUTME: Retains refusal after connector loss and honors the persistent HTTP marker.
+export function hasManagedMemoryHTTP(): boolean {
+  for (const name of ["memory-http.json", "memory-access.json"]) {
+    try {
+      lstatSync(resolve(homedir(), ".claude/LIFEOS/USER/CONFIG", name));
+      managedHTTP = true;
+    } catch (error: unknown) {
+      if (!memoryObject(error) || error.code !== "ENOENT") throw error;
+    }
+  }
+  return managedHTTP;
+}
