+      let version: string | undefined;
+      if (spec.id === "doctrine") {
+        const v = url.searchParams.get("version");
+        if (v) {
+          if (!/^\d+\.\d+\.\d+$/.test(v)) return Response.json({ error: "bad version" }, { status: 400 });
+          version = v;
+        }
+      }
+      const path = chainPath(spec, version, reader);
+      if (reader ? !hasFile(reader, path) : !existsSync(path)) return Response.json({ error: "file missing on disk" }, { status: 404 });
+      const st = reader ? reader.stat(path) : statSync(path);
+      return Response.json({ id, content: reader ? reader.text(path) : await Bun.file(path).text(), mtime: st.mtime.toISOString(), editable: spec.editable && !version });
+}
+
+export async function renderAlgorithmTabView(sources: {relative: string; content: string}[], target: string,
+    metadata: Record<string, {size: number; modified: number}>, versions: string[]): Promise<Response> {
+  const admitted = new Map(sources.map(source => [join(HOME, source.relative), source.content]));
+  const reader: AlgorithmReader = {
+    text(path) {
+      const content = admitted.get(path);
+      if (content === undefined) throw new Error("An admitted Algorithm source is unavailable");
+      return content;
+    },
+    stat(path) {
+      const relative = path.slice(HOME.length + 1);
+      const value = metadata[relative];
+      if (!value) throw new Error("An admitted Algorithm source is unavailable");
+      return {size: value.size, mtime: new Date(value.modified)};
+    },
+    versions: () => versions,
+  };
+  const request = new Request("http://localhost" + target);
+  return new URL(request.url).pathname.endsWith("/file") ? await fileView(request, reader) : Response.json(await compose(reader));
+}
