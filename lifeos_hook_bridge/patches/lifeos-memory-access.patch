+        || !/^[a-z][a-z-]{0,63}$/.test(url.searchParams.get("id") ?? "")
+        || url.searchParams.has("version") && !/^\d{1,10}\.\d{1,10}\.\d{1,10}$/.test(url.searchParams.get("version") ?? "")) {
+      return Response.json({error: "Choose a fixed Algorithm file and version"}, {status: 400, headers});
