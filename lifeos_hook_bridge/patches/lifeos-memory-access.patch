+export async function memoryHTTPPulseHealth(request: Request, render: () => Response): Promise<Response | null> {
+  if (!hasManagedMemoryHTTP()) return null;
+  const url = new URL(request.url);
+  const headers = {"cache-control": "no-store"};
+  if (!["/api/pulse/health", "/healthz"].includes(url.pathname)) {
+    return Response.json({error: "Choose a declared Pulse health route"}, {status: 404, headers});
+  }
+  if (request.method !== "GET") return Response.json({error: "Pulse health requires GET"}, {status: 405, headers});
+  if (url.search) return Response.json({error: "Pulse health requires fixed runtime observations"}, {status: 400, headers});
+  const origin = request.headers.get("origin");
+  if (origin && origin !== url.origin) return Response.json({error: "Pulse health requires the current origin"}, {status: 403, headers});
+  const cancellation = new AbortController();
+  const cancel = (): void => { cancellation.abort(); };
+  request.signal.addEventListener("abort", cancel, {once: true});
+  if (request.signal.aborted) cancel();
+  const deadline = setTimeout(cancel, 40_000);
+  const admittedRequest = new Request(request, {signal: cancellation.signal});
+  let cookies: string[] = [];
+  const deliver = (response: Response): Response => {
+    const updated = new Headers(response.headers);
+    const finalCookies = updated.getSetCookie();
+    updated.delete("set-cookie");
+    for (const cookie of [...cookies, ...finalCookies]) updated.append("set-cookie", cookie);
+    return new Response(response.body, {status: response.status, headers: updated});
+  };
+  try {
+    const admitted = await memoryHTTPResponseAsync(admittedRequest, "pulse_runtime");
+    if (admitted.status !== 200) return admitted;
+    cookies = admitted.headers.getSetCookie();
+    const authorization: unknown = await admitted.json();
+    if (!memoryObject(authorization) || authorization.admitted !== true) throw new Error("Pulse health requires current owner admission");
+    const nextHeaders = new Headers(request.headers);
+    const currentCookies = new Map<string, string>();
+    for (const pair of (nextHeaders.get("cookie") ?? "").split(";")) {
+      const split = pair.indexOf("=");
+      if (split > 0) currentCookies.set(pair.slice(0, split).trim(), pair.slice(split + 1).trim());
+    }
+    for (const cookie of cookies) {
+      const pair = cookie.split(";", 1)[0];
+      const split = pair.indexOf("=");
+      const name = pair.slice(0, split);
+      if (/^(?:__Host-|__Secure-)?hermes_session_(?:at|rt|provider)$/.test(name)) currentCookies.set(name, pair.slice(split + 1));
+    }
+    nextHeaders.set("cookie", [...currentCookies].map(([name, value]) => name + "=" + value).join("; "));
+    const currentRequest = new Request(request.url, {headers: nextHeaders, signal: cancellation.signal});
+    const response = render();
+    const body: unknown = await response.json();
+    const observation = {status: response.status, body, observed_at: new Date().toISOString()};
+    return deliver(await memoryHTTPResponseAsync(currentRequest, "pulse_runtime", undefined, observation));
+  } catch { return deliver(Response.json({error: "Authenticated Pulse health is unavailable"}, {status: 503, headers})); }
+  finally {
+    clearTimeout(deadline);
+    request.signal.removeEventListener("abort", cancel);
+  }
+}
