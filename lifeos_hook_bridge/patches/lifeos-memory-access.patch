+interface MemoryHTTPResponse {
+  status: number;
+  headers: string[][];
+  body: string;
+}
+
+export function memoryHTTPResponse(request: Request, view: string, target?: string): Response {
+  return memoryHTTP({view, authorization: request.headers.get("authorization") ?? "",
+    cookie: request.headers.get("cookie") ?? "", ...(target === undefined ? {} : {target})});
+}
