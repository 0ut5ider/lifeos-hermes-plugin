+async function contentStream(request: Request): Promise<Response> {
+  const initial = await memoryHTTPResponseAsync(request, "life", "/api/content");
+  if (initial.status !== 200) return initial;
+  const first = await initial.text();
+  const cancellation = new AbortController();
+  const currentRequest = new Request(request, {signal: cancellation.signal});
+  let stopped = false;
+  let timer: ReturnType<typeof setTimeout> | null = null;
+  let closeStream = (): void => {};
+  const body = new ReadableStream<Uint8Array>({
+    start(controller) {
+      const encoder = new TextEncoder();
+      closeStream = (): void => {
+        if (stopped) return;
+        stopped = true;
+        if (timer !== null) clearTimeout(timer);
+        request.signal.removeEventListener("abort", closeStream);
+        cancellation.abort();
+        try { controller.close(); } catch {}
+      };
+      if (request.signal.aborted) { closeStream(); return; }
+      request.signal.addEventListener("abort", closeStream, {once: true});
+      controller.enqueue(encoder.encode(`data: ${first}\n\n`));
+      const poll = async (): Promise<void> => {
+        try {
+          const response = await memoryHTTPResponseAsync(currentRequest, "life", "/api/content");
+          if (stopped) return;
+          if (response.status !== 200) { closeStream(); return; }
+          controller.enqueue(encoder.encode(`data: ${await response.text()}\n\n`));
+          if (!stopped) timer = setTimeout(() => { void poll(); }, 1500);
+        } catch { closeStream(); }
+      };
+      timer = setTimeout(() => { void poll(); }, 1500);
+    },
+    cancel() { closeStream(); },
+  });
+  const headers = new Headers(initial.headers);
+  headers.set("content-type", "text/event-stream; charset=utf-8");
+  return new Response(body, {headers});
+}
