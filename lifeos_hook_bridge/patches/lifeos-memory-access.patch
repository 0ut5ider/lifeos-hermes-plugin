+export function renderTelosOverview(sources: ReadonlyArray<{relative: string; content: string}>, state: string): Promise<Response> {
+  const allowed = new Set(telosOverviewSources());
+  if (sources.length > allowed.size || sources.some(source => !allowed.has(source.relative))
+      || new Set(sources.map(source => source.relative)).size !== sources.length || typeof state !== "string") {
+    throw new Error("Choose declared current TELOS overview sources");
+  }
+  const contents = new Map(sources.map(source => [join(dirname(LIFEOS_DIR), source.relative), source.content]));
+  const statePath = join(TELOS_DIR, "LIFEOS_STATE.json");
+  contents.set(statePath, state);
