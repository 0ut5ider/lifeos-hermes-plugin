+export function renderOperationalView(sources: ReadonlyArray<{relative: string; content: string}>, target: string,
+    folded?: {climb: Map<string, ClimbPoint[]>; activity: Map<string, ToolTick[]>}): Response {
+  const allowed = new Set(["LIFEOS/MEMORY/STATE/work.json", "LIFEOS/MEMORY/STATE/work-events.jsonl",
+    "LIFEOS/MEMORY/OBSERVABILITY/tool-activity.jsonl", "LIFEOS/MEMORY/OBSERVABILITY/subagent-events.jsonl",
+    "LIFEOS/MEMORY/OBSERVABILITY/tool-failures.jsonl", "LIFEOS/MEMORY/VOICE/voice-events.jsonl",
+    "LIFEOS/MEMORY/STATE/novelty-state.json"]);
+  if (sources.length > allowed.size || sources.some(source => !allowed.has(source.relative))
+      || new Set(sources.map(source => source.relative)).size !== sources.length) {
+    throw new Error("Choose fixed operational source snapshots");
+  }
+  const contents = new Map(sources.map(source => [join(dirname(LIFEOS_DIR), source.relative), source.content]));
+  const read = (path: string, maximum = 100): Array<Record<string, unknown>> => {
+    if (!allowed.has(path.slice(dirname(LIFEOS_DIR).length + 1))) throw new Error("Choose fixed operational sources");
+    const result: Array<Record<string, unknown>> = [];
+    for (const line of (contents.get(path) ?? "").split("\n")) {
+      if (!line) continue;
+      const value: unknown = JSON.parse(line);
+      if (memoryObject(value)) result.push(value);
+    }
+    return result.slice(-maximum);
+  };
+  if (target === "/api/novelty") return handleNoveltyApi(path => contents.get(path));
+  if (target === "/api/agents") return handleAgentsApi(read);
+  if (target === "/api/events/recent") return handleEventsRecentApi(read);
+  if (target === "/api/observability/voice-events") return handleVoiceEventsApi(read);
+  if (target === "/api/observability/tool-failures") return handleToolFailuresApi(read);
+  if (target === "/api/algorithm") {
+    const climb = folded?.climb ?? new Map<string, ClimbPoint[]>();
+    for (const line of (contents.get(WORK_EVENTS_PATH) ?? "").split("\n")) foldClimbLine(climb, line);
+    evictSeriesByCount(climb, CLIMB_SERIES_CAP);
+    const activity = folded?.activity ?? new Map<string, ToolTick[]>();
+    for (const line of (contents.get(TOOL_ACTIVITY_PATH) ?? "").split("\n")) foldActivityLine(line, activity);
+    evictSeriesByAge(activity, Date.now(), ACTIVITY_RETENTION_MS);
+    return Response.json(buildAlgorithmStatePayload({work: contents.get(WORK_JSON_PATH), climb, activity}));
+  }
+  throw new Error("Choose a fixed operational read route");
+}
+
+export async function renderOperationalHistory(sources: ReadonlyArray<{relative: string; content: string}>, descriptor: number,
+    target = "/api/algorithm"): Promise<Response> {
+  const capabilities = /^\/api\/capabilities(?:\?window=(?:60|360|1440))?$/.test(target);
+  if (target !== "/api/algorithm" && !capabilities) throw new Error("Choose a fixed streamed operational route");
+  const before = fstatSync(descriptor);
+  if (!before.isFile() || before.uid !== process.getuid?.() || before.nlink !== 0 || (before.mode & 0o077) !== 0) {
+    throw new Error("Operational history requires an anonymous private owner snapshot");
+  }
+  const climb = new Map<string, ClimbPoint[]>();
+  const activity = new Map<string, ToolTick[]>();
+  const telemetry = new Map<string, Array<Record<string, unknown>>>();
+  const input = createReadStream(`/proc/self/fd/${descriptor}`);
+  const lines = createInterface({input, crlfDelay: Infinity});
+  try {
+    for await (const line of lines) {
+      if (Buffer.byteLength(line) > 3 * 1024 * 1024) throw new Error("An admitted history record exceeds its transport limit");
+      const frame: unknown = JSON.parse(line);
+      if (!memoryObject(frame) || typeof frame.content !== "string") throw new Error("Operational history requires declared event records");
+      if (capabilities && (frame.relative === "LIFEOS/MEMORY/OBSERVABILITY/tool-activity.jsonl"
+          || frame.relative === "LIFEOS/MEMORY/OBSERVABILITY/subagent-events.jsonl")) {
+        const value: unknown = JSON.parse(frame.content);
+        if (!memoryObject(value)) throw new Error("Capability telemetry requires admitted event objects");
+        const rows = telemetry.get(frame.relative) ?? [];
+        rows.push(value);
+        telemetry.set(frame.relative, rows);
+      } else if (!capabilities && frame.relative === "LIFEOS/MEMORY/STATE/work-events.jsonl") foldClimbLine(climb, frame.content);
+      else if (!capabilities && frame.relative === "LIFEOS/MEMORY/OBSERVABILITY/tool-activity.jsonl") foldActivityLine(frame.content, activity);
+      else throw new Error("Operational history requires fixed event sources");
+    }
+  } finally { lines.close(); input.destroy(); }
+  const after = fstatSync(descriptor);
+  if (before.dev !== after.dev || before.ino !== after.ino || before.size !== after.size || before.mtimeMs !== after.mtimeMs) {
+    throw new Error("The admitted history snapshot changes during folding");
+  }
+  if (capabilities) {
+    if (sources.length !== 0) throw new Error("Streamed telemetry requires only its admitted descriptor");
+    return handleCapabilitiesApi(new URLSearchParams(target.split("?")[1]), path => {
+      const relative = path.slice(dirname(LIFEOS_DIR).length + 1);
+      if (!["LIFEOS/MEMORY/OBSERVABILITY/tool-activity.jsonl", "LIFEOS/MEMORY/OBSERVABILITY/subagent-events.jsonl"].includes(relative)) {
+        throw new Error("Choose fixed capability sources");
+      }
+      return telemetry.get(relative) ?? [];
+    });
+  }
+  return renderOperationalView(sources, "/api/algorithm", {climb, activity});
+}
