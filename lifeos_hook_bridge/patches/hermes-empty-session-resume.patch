+class TestResumeWithoutAgentFinalizesPreviousSession:
+    def test_resume_notifies_empty_session_with_resume_reason(self):
+        cli_obj = _make_cli()
+        cli_obj.agent = None
+        cli_obj._session_db.get_session.return_value = {"id": "target", "title": "T"}
+        cli_obj._session_db.get_resume_conversations.return_value = ([], [])
+        cli_obj._session_db.resolve_resume_session_id.return_value = "target"
+        observed = []
+        cli_obj._notify_session_boundary = lambda event, **kwargs: observed.append(
+            (event, kwargs.get("reason"), cli_obj.session_id))
+
+        with (
+            patch("hermes_cli.main._resolve_session_by_name_or_id", return_value="target"),
+            patch("cli._cprint"),
+        ):
+            cli_obj._handle_resume_command("/resume target")
+
+        assert observed == [("on_session_finalize", "resume", "current_session")]
+
