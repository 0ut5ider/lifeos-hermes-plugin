diff --git a/tests/hermes_cli/test_source_launcher_publication.py b/tests/hermes_cli/test_source_launcher_publication.py
index 43a959863..3334dfaf3 100644
--- a/tests/hermes_cli/test_source_launcher_publication.py
+++ b/tests/hermes_cli/test_source_launcher_publication.py
@@ -540,3 +540,29 @@ def test_update_import_probe_uses_selected_dependencies(tmp_path, monkeypatch):
     (repo / "hermes_integrity_probe.py").write_text("import selected_probe\n", encoding="utf-8")
     monkeypatch.setattr(update_cmd, "_UPDATE_CRITICAL_MODULES", ("hermes_integrity_probe",))
     assert update_cmd_validation._critical_module_import_failures(repo, report_runtime_errors=True) == {}
+
+
+def test_plugin_script_runs_with_selected_hermes_runtime(tmp_path, monkeypatch):
+    repo, home, interpreter = fixture_tree(tmp_path, monkeypatch)
+    select_generation(repo, "plugin", "selected")
+    out = tmp_path / "commands"
+    out.mkdir()
+    _launchers.ensure_install_launchers(repo, out)
+    plugin_script = tmp_path / "plugin script.py"
+    plugin_script.write_text(
+        "import json, os, sys\n"
+        "from selected_probe import VALUE\n"
+        "print(json.dumps({'value': VALUE, 'args': sys.argv[1:], "
+        "'home': os.environ.get('HERMES_HOME'), 'exe': sys.executable}))\n",
+        encoding="utf-8",
+    )
+    result = subprocess.run(
+        [str(out / "hermes"), "--run-file", str(plugin_script), "model", "high"],
+        capture_output=True, text=True, encoding="utf-8", timeout=30,
+    )
+    assert result.returncode == 0, result.stdout + result.stderr
+    payload = json.loads(result.stdout)
+    assert payload["value"] == "selected"
+    assert payload["args"] == ["model", "high"]
+    assert Path(payload["home"]) == home
+    assert Path(payload["exe"]).samefile(interpreter)
diff --git a/tests/test_lifeos_aux_no_fallback.py b/tests/test_lifeos_aux_no_fallback.py
new file mode 100644
index 000000000..836728ed8
--- /dev/null
+++ b/tests/test_lifeos_aux_no_fallback.py
@@ -0,0 +1,40 @@
+# ABOUTME: Verifies a selected LifeOS provider cannot fall back to another provider.
+# ABOUTME: Uses a failing local HTTP endpoint and checks the recovery boundary.
+
+import threading
+import unittest
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from unittest.mock import patch
+
+from agent.auxiliary_client import call_llm
+
+
+class LifeOSAuxNoFallbackTests(unittest.TestCase):
+    def test_explicit_route_stops_before_provider_fallback(self):
+        class Endpoint(BaseHTTPRequestHandler):
+            def do_POST(self):
+                self.send_response(503)
+                self.send_header("Content-Type", "application/json")
+                self.end_headers()
+                self.wfile.write(b'{"error":{"message":"unavailable"}}')
+
+            def log_message(self, *_args):
+                pass
+
+        server = ThreadingHTTPServer(("127.0.0.1", 0), Endpoint)
+        thread = threading.Thread(target=server.serve_forever, daemon=True)
+        thread.start()
+        self.addCleanup(server.server_close)
+        self.addCleanup(server.shutdown)
+        with patch("agent.auxiliary_client._ladder_provider_fallback") as fallback:
+            with self.assertRaises(Exception) as caught:
+                call_llm(provider="custom", model="test-model",
+                         base_url=f"http://127.0.0.1:{server.server_port}/v1",
+                         api_key="test-only", messages=[{"role": "user", "content": "hi"}],
+                         max_tokens=8, timeout=2, allow_provider_fallback=False)
+            self.assertNotIsInstance(caught.exception, TypeError)
+            fallback.assert_not_called()
+
+
+if __name__ == "__main__":
+    unittest.main()
