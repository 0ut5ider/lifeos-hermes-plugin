+# ABOUTME: Requires current profile policy before private Discord content delivery.
+# ABOUTME: Binds the transport credential without exposing it to plugin callbacks.
+from hmac import compare_digest
+
+
+async def authorize_delivery(chat_id, *, guild_id='', token=''):
+    from agent.secret_scope import get_secret
+    from hermes_constants import get_hermes_home
+    from hermes_cli.plugins import get_plugin_manager
+    expected = get_secret('DISCORD_BOT_TOKEN', '')
+    if not isinstance(token, str) or not token or not isinstance(expected, str) or not compare_digest(token, expected):
+        raise PermissionError('Private Discord delivery has a different profile credential')
+    results = await get_plugin_manager().ainvoke_hook('pre_message_delivery',
+        platform='discord', chat_id=str(chat_id), guild_id=str(guild_id), hermes_home=str(get_hermes_home()))
+    if not results or any(not isinstance(result, dict) or result.get('action') != 'allow' for result in results):
+        raise PermissionError('Current Discord permissions do not admit private delivery')
