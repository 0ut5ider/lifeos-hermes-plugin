diff --git a/plugins/platforms/discord/adapter_channel_policy.py b/plugins/platforms/discord/adapter_channel_policy.py
new file mode 100644
index 00000000..8fb1cd43
--- /dev/null
+++ b/plugins/platforms/discord/adapter_channel_policy.py
@@ -0,0 +1,82 @@
+# ABOUTME: Constrains Discord input and private delivery to the selected guild text channel.
+# ABOUTME: Retains native slash authorization and refuses separate thread or direct-message targets.
+from __future__ import annotations
+
+def _guild_channel_target(restriction, allowed: set):
+    """Return the selected channel, None for disabled mode, or empty for refusal."""
+    if restriction is None or str(restriction).lower() in {'false', '0', 'no'}:
+        return None
+    if str(restriction).lower() not in {'true', '1', 'yes'}:
+        return ''
+    if len(allowed) == 1 and all(value.isascii() and value.isdecimal() for value in allowed):
+        return next(iter(allowed))
+    return ''
+
+
+def standalone_channel_refusal(pconfig, chat_id, thread_id):
+    from gateway.platforms._shared import platform_gate_env
+    from plugins.platforms.discord.adapter import DiscordAdapter
+    extra = getattr(pconfig, "extra", None)
+    extra = extra if isinstance(extra, dict) else {}
+    restriction = platform_gate_env("DISCORD_GUILD_CHANNEL_ONLY") or extra.get("guild_channel_only")
+    allowed = platform_gate_env("DISCORD_ALLOWED_CHANNELS") or extra.get("allowed_channels")
+    selected = _guild_channel_target(restriction, DiscordAdapter._gate_csv_set(allowed))
+    return selected is not None and (str(chat_id) != selected or bool(thread_id))
+
+class DiscordChannelPolicyMixin:
+    async def _require_private_delivery(self, channel):
+        if self._guild_channel_restriction() is None:
+            return
+        if not self._guild_channel_allows(channel):
+            raise PermissionError('Private Discord delivery requires the selected guild text channel')
+        from plugins.platforms.discord.delivery import authorize_delivery
+        await authorize_delivery(str(channel.id), guild_id=str(channel.guild.id),
+                                 token=getattr(self._client.http, 'token', ''))
+
+
+    def _evaluate_slash_authorization(self, interaction):
+        if not self._guild_channel_allows(getattr(interaction, 'channel', None)):
+            return False, 'The bot accepts commands only in its selected guild text channel'
+        return super()._evaluate_slash_authorization(interaction)
+
+
+    def _guild_channel_restriction(self):
+        restriction = self._gate_raw('guild_channel_only', 'DISCORD_GUILD_CHANNEL_ONLY')
+        return _guild_channel_target(restriction, self._get_allowed_channels())
+
+
+    def _guild_channel_allows(self, channel) -> bool:
+        from plugins.platforms.discord.adapter import discord
+        selected = self._guild_channel_restriction()
+        return (selected is None or isinstance(channel, discord.TextChannel)
+                and channel.type == discord.ChannelType.text and str(channel.id) == selected)
+
+
+
+async def authorize_standalone_delivery(pconfig, chat_id, token):
+    from gateway.platforms._shared import platform_gate_env
+    from plugins.platforms.discord.adapter import DiscordAdapter
+    extra = getattr(pconfig, "extra", None)
+    extra = extra if isinstance(extra, dict) else {}
+    restriction = platform_gate_env("DISCORD_GUILD_CHANNEL_ONLY") or extra.get("guild_channel_only")
+    allowed = platform_gate_env("DISCORD_ALLOWED_CHANNELS") or extra.get("allowed_channels")
+    if _guild_channel_target(restriction, DiscordAdapter._gate_csv_set(allowed)) is not None:
+        from plugins.platforms.discord.delivery import authorize_delivery
+        await authorize_delivery(chat_id, token=token)
+
+
+def reraise_delivery_refusal(error):
+    if isinstance(error, PermissionError):
+        raise error
+
+
+def readable_standalone_media(media_files):
+    import os
+    from plugins.platforms.discord.adapter import _standalone_warn_missing_media
+    available, warnings = [], []
+    for path, _is_voice in media_files:
+        if os.path.exists(path):
+            available.append(path)
+        else:
+            warnings.append(_standalone_warn_missing_media(path))
+    return available, warnings
