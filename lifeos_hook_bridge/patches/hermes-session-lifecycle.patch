+# ABOUTME: Exercises command synchronization with real Discord command models and trees.
+# ABOUTME: Checks inherited settings, explicit updates, and command identity with isolated transport state.
+
+import copy
+import unittest
+import warnings
+
+import discord
+from discord.ext import commands
+
+from gateway.config import PlatformConfig
+from plugins.platforms.discord.adapter import DiscordAdapter
+
+
+class CommandTransport:
+    """Keep API state in memory for unit tests; live Discord acceptance is separate."""
+
+    def __init__(self, payload):
+        self.payloads = {payload["id"]: copy.deepcopy(payload)}
+        self.operations = []
+
+    async def get_global_commands(self, application_id):
+        return copy.deepcopy(list(self.payloads.values()))
+
+    async def close(self):
+        pass
+
+    async def delete_global_command(self, application_id, command_id):
+        self.operations.append(("delete", command_id))
+        del self.payloads[str(command_id)]
+
+    async def upsert_global_command(self, application_id, payload):
+        current = next((item for item in self.payloads.values()
+                        if item["name"] == payload["name"] and item["type"] == payload["type"]), None)
+        command_id = current["id"] if current else "456"
+        result = {**(current or {}), **copy.deepcopy(payload), "id": command_id,
+                  "application_id": str(application_id)}
+        self.payloads[command_id] = result
+        self.operations.append(("upsert", command_id))
+        return copy.deepcopy(result)
+
+    async def edit_global_command(self, application_id, command_id, payload):
+        # discord.py only forwards these fields on its edit route.
+        result = self.payloads[str(command_id)]
+        result.update({key: copy.deepcopy(payload[key]) for key in ("name", "description", "options")
+                       if key in payload})
+        self.operations.append(("edit", str(command_id)))
+        return copy.deepcopy(result)
+
+
+class DiscordCommandIdentityTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        captured = warnings.catch_warnings(record=True)
+        recorded = captured.__enter__()
+        def finish_warnings():
+            captured.__exit__(None, None, None)
+            for warning in recorded:
+                self.assertIs(warning.category, DeprecationWarning)
+                self.assertIn("asyncio.iscoroutinefunction", str(warning.message))
+                self.assertIn("discord/ext/commands/core.py", warning.filename)
+        self.addCleanup(finish_warnings)
+        warnings.simplefilter('always', DeprecationWarning)
+        self.bot = commands.Bot(command_prefix="!", intents=discord.Intents.none(), application_id=999)
+        self.addAsyncCleanup(self.bot.close)
+
+        async def stop(interaction):
+            pass
+
+        self.command = discord.app_commands.Command(name="stop", description="Stop Hermes", callback=stop)
+        self.bot.tree.add_command(self.command)
+        self.payload = {**self.command.to_dict(self.bot.tree), "id": "123", "application_id": "999",
+                        "integration_types": [0, 1], "contexts": [0, 1, 2]}
+        self.transport = CommandTransport(self.payload)
+        self.bot.http = self.transport
+        self.bot.tree._http = self.transport
+        self.adapter = DiscordAdapter(PlatformConfig(enabled=True, token="synthetic-offline-token"))
+        self.adapter._client = self.bot
+
+    async def test_inherited_settings_keep_an_unchanged_command(self):
+        summary = await self.adapter._safe_sync_slash_commands()
+        self.assertEqual(summary["unchanged"], 1)
+        self.assertEqual(self.transport.operations, [])
+        self.assertIn("123", self.transport.payloads)
+
+    async def test_explicit_settings_change_keeps_the_command_id(self):
+        self.command.nsfw = True
+        summary = await self.adapter._safe_sync_slash_commands()
+        self.assertEqual(summary["updated"], 1)
+        self.assertEqual(summary["recreated"], 0)
+        self.assertIn("123", self.transport.payloads)
+        self.assertTrue(self.transport.payloads["123"]["nsfw"])
+        self.assertNotIn(("delete", 123), self.transport.operations)
+
+    async def test_description_and_settings_change_both_reach_the_api(self):
+        self.command.description = "Stop the running Hermes agent"
+        self.command.nsfw = True
+        summary = await self.adapter._safe_sync_slash_commands()
+        self.assertEqual(summary["updated"], 1)
+        self.assertEqual(self.transport.payloads["123"]["description"], self.command.description)
+        self.assertTrue(self.transport.payloads["123"]["nsfw"])
+
+    async def test_explicit_contexts_do_not_match_other_contexts(self):
+        self.command.allowed_contexts = discord.app_commands.AppCommandContext(guild=True, dm_channel=False,
+                                                                               private_channel=False)
+        summary = await self.adapter._safe_sync_slash_commands()
+        self.assertEqual(summary["updated"], 1)
+        self.assertEqual(self.transport.payloads["123"]["contexts"], [0])
+
+    async def test_description_change_updates_the_existing_command(self):
+        self.command.description = "Stop the running Hermes agent"
+        summary = await self.adapter._safe_sync_slash_commands()
+        self.assertEqual(summary["updated"], 1)
+        self.assertEqual(self.transport.payloads["123"]["description"], self.command.description)
+        self.assertEqual(summary["deleted"], 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
