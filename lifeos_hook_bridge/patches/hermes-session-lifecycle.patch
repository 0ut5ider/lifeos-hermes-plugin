diff --git a/tests/gateway/test_clarify_cancellation_outcome.py b/tests/gateway/test_clarify_cancellation_outcome.py
new file mode 100644
index 00000000..9d9b2796
--- /dev/null
+++ b/tests/gateway/test_clarify_cancellation_outcome.py
@@ -0,0 +1,156 @@
+# ABOUTME: Checks cancellation, timeout, and deliberate empty answers through the actual question queue.
+# ABOUTME: Preserves earlier batch answers and prevents cancellation notices from becoming user answers.
+from concurrent.futures import Future, ThreadPoolExecutor
+import asyncio
+import contextvars
+import json
+from pathlib import Path
+import tempfile
+import threading
+from types import SimpleNamespace
+import unittest
+
+from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+from gateway.platforms.base import SendResult
+from gateway.run_turn_runner_clarify_delivery import _clarify_send_then_wait
+from tools import clarify_gateway as queue
+from tools.clarify_tool import clarify_tool
+
+
+class ClarifyCancellationOutcomeTests(unittest.TestCase):
+    def setUp(self):
+        directory = tempfile.TemporaryDirectory()
+        self.addCleanup(directory.cleanup)
+        token = set_hermes_home_override(Path(directory.name))
+        self.addCleanup(reset_hermes_home_override, token)
+        self.addCleanup(queue.clear_session, 'synthetic-cancellation')
+        self.addCleanup(queue.clear_session, 'synthetic-cancellation-other')
+        (Path(directory.name) / 'config.yaml').write_text('agent:\n  clarify_timeout: 1\n')
+        self.assertEqual(queue.get_clarify_timeout(), 1)
+
+    def tool_result(self, response):
+        from gateway.run_turn_runner import TurnRunner
+        runner = object.__new__(TurnRunner)
+        runner._ask_clarify_question = lambda *args, **kwargs: response
+        return json.loads(clarify_tool(questions=[{'question':'Choose','choices':['A','B']}],
+            callback=runner._clarify_callback_sync))
+
+    def completed_send(self):
+        future = Future()
+        future.set_result(SendResult(success=True, message_id='synthetic-offline-card'))
+        return future
+
+    def test_cancellation_is_not_a_timeout_or_an_answer(self):
+        entry = queue.register('cancel-outcome', 'synthetic-cancellation', 'Choose', ['A', 'B'])
+        sent = self.completed_send()
+        started = threading.Event()
+
+        class ObservedEvent(threading.Event):
+            def wait(self, timeout=None):
+                started.set()
+                return super().wait(timeout)
+
+        entry.event = ObservedEvent()
+
+        def wait():
+            return _clarify_send_then_wait(sent, clarify_id=entry.clarify_id,
+                session_key=entry.session_key, clarify_mod=queue)
+
+        with ThreadPoolExecutor(max_workers=1) as executor:
+            response = executor.submit(contextvars.copy_context().run, wait)
+            self.assertTrue(started.wait(2))
+            queue.clear_session(entry.session_key)
+            raw, answered = response.result(timeout=3)
+        result = self.tool_result((raw, answered))
+        self.assertFalse(answered)
+        self.assertIsNone(result['responses'][0]['user_response'])
+        self.assertEqual(result['outcome'], 'cancelled')
+        self.assertNotIn('timed_out', result)
+        self.assertNotIn('within', result.get('notice', ''))
+        self.assertFalse(queue.resolve_gateway_clarify(entry.clarify_id, 'A'))
+
+    def test_actual_timeout_keeps_the_timeout_outcome(self):
+        entry = queue.register('timeout-outcome', 'synthetic-cancellation', 'Choose', ['A', 'B'])
+        response = _clarify_send_then_wait(self.completed_send(), clarify_id=entry.clarify_id,
+            session_key=entry.session_key, clarify_mod=queue)
+        self.assertFalse(response[1])
+        self.assertIn('did not respond', response[0])
+
+    def test_cancelled_entry_does_not_remove_a_successor_with_the_same_identifier(self):
+        entry = queue.register('reused-outcome', 'synthetic-cancellation', 'First', ['A', 'B'])
+        queue.clear_session(entry.session_key)
+        successor = queue.register(entry.clarify_id, entry.session_key, 'Second', ['A', 'B'])
+        self.assertEqual(queue.wait_for_response(entry, 1), queue.CANCELLED)
+        self.assertIs(queue.get_pending_for_session(entry.session_key, include_choice_prompts=True), successor)
+        self.assertTrue(queue.resolve_gateway_clarify(successor.clarify_id, 'B'))
+        self.assertEqual(queue.wait_for_response(successor, 1), 'B')
+
+    def test_deliberate_empty_answer_does_not_report_a_timeout(self):
+        entry = queue.register('empty-outcome', 'synthetic-cancellation', 'Choose', ['A', 'B'])
+        self.assertTrue(queue.resolve_gateway_clarify(entry.clarify_id, ''))
+        self.assertEqual(_clarify_send_then_wait(self.completed_send(), clarify_id=entry.clarify_id,
+            session_key=entry.session_key, clarify_mod=queue), ('', True))
+
+    def test_batch_callback_accepts_the_actual_queue_cancellation_marker(self):
+        entry = queue.register('batch-marker', 'synthetic-cancellation', 'Choose', ['A', 'B'])
+        queue.clear_session(entry.session_key)
+
+        result = self.tool_result((queue.wait_for_response(entry, 1), False))
+        self.assertEqual(result['outcome'], 'cancelled')
+        self.assertNotIn('timed_out', result)
+        self.assertIsNone(result['responses'][0]['user_response'])
+
+    def test_user_text_that_matches_the_cancellation_notice_remains_an_answer(self):
+        entry = queue.register('literal-outcome', 'synthetic-cancellation', 'Choose', None)
+        self.assertTrue(queue.resolve_gateway_clarify(entry.clarify_id, '[clarify cancelled]'))
+        response = _clarify_send_then_wait(self.completed_send(), clarify_id=entry.clarify_id,
+            session_key=entry.session_key, clarify_mod=queue)
+        self.assertEqual(response, ('[clarify cancelled]', True))
+
+    def test_batch_cancellation_during_send_preserves_earlier_answers(self):
+        from gateway.run_turn_runner import TurnRunner
+
+        class CardSurface:
+            def __init__(self):
+                self.questions = []
+                self.retired = []
+
+            def pause_typing_for_chat(self, _chat):
+                pass
+
+            async def send_clarify(self, **arguments):
+                self.questions.append(arguments['question'])
+                if len(self.questions) == 1:
+                    queue.resolve_gateway_clarify(arguments['clarify_id'], 'A')
+                else:
+                    queue.clear_session(arguments['session_key'])
+                return SendResult(success=True, message_id='synthetic-offline-card')
+
+            async def retire_clarify_card(self, identifier, notice):
+                self.retired.append(notice)
+
+        surface = CardSurface()
+        runner = object.__new__(TurnRunner)
+        runner._ctx = SimpleNamespace(_status_adapter=surface, _status_chat_id='synthetic-channel',
+            _status_thread_metadata={}, session_key='synthetic-cancellation', stream_consumer_holder=[None])
+        runner._close_native_stream_boundary = lambda *args, **kwargs: None
+
+        def schedule(coroutine, _label):
+            future = Future()
+            future.set_result(asyncio.run(coroutine))
+            return future
+
+        runner._schedule = schedule
+        result = json.loads(clarify_tool(questions=[{'question': question, 'choices': ['A', 'B']}
+            for question in ('First', 'Second', 'Third')], callback=runner._clarify_callback_sync))
+        self.assertEqual([text.split('\n')[0] for text in surface.questions], ['First', 'Second'])
+        self.assertEqual([row['user_response'] for row in result['responses']], ['A', None, None])
+        self.assertEqual(result['outcome'], 'cancelled')
+        self.assertNotIn('timed_out', result)
+        self.assertEqual(len(surface.retired), 1)
+        self.assertIn('cancel', surface.retired[0].lower())
+        self.assertNotIn('expired', surface.retired[0].lower())
+
+
+if __name__ == '__main__':
+    unittest.main()
