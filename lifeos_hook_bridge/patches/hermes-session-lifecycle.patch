diff --git a/tests/gateway/test_stop_clarify_waiters.py b/tests/gateway/test_stop_clarify_waiters.py
new file mode 100644
index 00000000..c3b7d4d2
--- /dev/null
+++ b/tests/gateway/test_stop_clarify_waiters.py
@@ -0,0 +1,114 @@
+# ABOUTME: Verifies that gateway interruption releases actual clarification waiters.
+# ABOUTME: Checks session isolation and late answers without model or Discord requests.
+
+import asyncio
+import contextvars
+import sqlite3
+import tempfile
+import threading
+import unittest
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+from gateway.config import GatewayConfig, Platform
+from gateway.run import GatewayRunner, _AGENT_PENDING_SENTINEL
+from gateway.session import SessionSource
+from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+from tools import clarify_gateway as queue
+
+
+class StopClarifyWaiterTests(unittest.IsolatedAsyncioTestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory(prefix="gateway-clarify-stop-")
+        self.addCleanup(self.directory.cleanup)
+        home = Path(self.directory.name)
+        (home / "config.yaml").write_text("database:\n  journal_mode: wal\n")
+        database = sqlite3.connect(home / "state.db")
+        try:
+            database.execute("PRAGMA journal_mode=WAL")
+        finally:
+            database.close()
+        token = set_hermes_home_override(home)
+        self.addCleanup(reset_hermes_home_override, token)
+        self.runner = GatewayRunner(config=GatewayConfig())
+        self.source = SessionSource(platform=Platform.DISCORD, chat_id="synthetic-stop",
+                                    chat_type="group", user_id="synthetic-user")
+        self.key = "synthetic-clarify-stop"
+        self.addCleanup(queue.clear_session, self.key)
+        self.addCleanup(queue.clear_session, "synthetic-other-chat")
+        self.addCleanup(self.runner._session_db._db.close)
+
+    async def stop(self):
+        await self.runner._interrupt_and_clear_session(
+            self.key, self.source, interrupt_reason="explicit stop requested",
+            invalidation_reason="stop_command")
+
+    async def test_stop_without_a_prompt_invalidates_and_releases_the_turn(self):
+        self.runner._running_agents[self.key] = _AGENT_PENDING_SENTINEL
+        generation = self.runner._begin_session_run_generation(self.key)
+        await self.stop()
+        self.assertGreater(self.runner._current_session_run_generation(self.key), generation)
+        self.assertNotIn(self.key, self.runner._running_agents)
+        self.assertIsNone(queue.get_pending_for_session(self.key, include_choice_prompts=True))
+
+    async def test_an_answer_already_received_survives_stop_cleanup(self):
+        entry = queue.register("answered-before-stop", self.key, "Choose", ["A", "B"])
+        self.assertTrue(queue.resolve_gateway_clarify(entry.clarify_id, "A"))
+        # The waiter retains the entry while the session cleanup removes its public lookup.
+        with ThreadPoolExecutor(max_workers=1) as workers:
+            response = workers.submit(queue.wait_for_response, entry.clarify_id, 2)
+            self.assertEqual(response.result(timeout=3), "A")
+        await self.stop()
+        self.assertFalse(queue.resolve_gateway_clarify(entry.clarify_id, "B"))
+
+    async def test_stop_releases_waiter_and_rejects_late_answers(self):
+        from run_agent import AIAgent
+        agent = AIAgent(api_key="synthetic-offline-key", base_url="http://127.0.0.1:1/v1",
+                        provider="custom", api_mode="chat_completions", model="synthetic-offline-model",
+                        enabled_toolsets=[], quiet_mode=True, platform="discord",
+                        skip_memory=True, skip_background_review=True)
+        from hermes_logging import _reset_queued_handlers
+        self.addCleanup(_reset_queued_handlers)
+        self.addCleanup(agent.close)
+        self.runner._running_agents[self.key] = agent
+        entry = queue.register("pending-stop-question", self.key, "Choose", ["A", "B"])
+        other = queue.register("other-chat-question", "synthetic-other-chat", "Choose", ["A", "B"])
+        started = threading.Event()
+
+        def wait():
+            started.set()
+            return queue.wait_for_response(entry.clarify_id, 30)
+
+        context = contextvars.copy_context()
+        with ThreadPoolExecutor(max_workers=1) as workers:
+            response = workers.submit(context.run, wait)
+            self.assertTrue(started.wait(timeout=2))
+            try:
+                await self.stop()
+                self.assertTrue(agent._hard_interrupt_requested.is_set())
+                from tools.clarify_gateway import CANCELLED
+                self.assertEqual(await asyncio.wait_for(asyncio.wrap_future(response), timeout=2), CANCELLED)
+                self.assertIsNone(queue.get_pending_for_session(self.key, include_choice_prompts=True))
+                self.assertFalse(queue.resolve_gateway_clarify(entry.clarify_id, "late"))
+                self.assertFalse(other.event.is_set())
+                self.assertTrue(queue.resolve_gateway_clarify(other.clarify_id, "B"))
+            finally:
+                queue.clear_session(self.key)
+
+    async def test_sync_interruption_clears_all_prompts_before_a_successor_registers(self):
+        entries = [queue.register("pending-" + str(index), self.key, "Choose", None)
+                   for index in range(2)]
+        self.runner._interrupt_running_turn(self.key, interrupt_reason="session evicted",
+                                            invalidation_reason="eviction")
+        successor = queue.register("successor-question", self.key, "Choose again", ["A", "B"])
+        try:
+            self.assertTrue(all(entry.event.is_set() for entry in entries))
+            self.assertFalse(successor.event.is_set())
+            self.assertIs(queue.get_pending_for_session(self.key, include_choice_prompts=True), successor)
+            self.assertTrue(queue.resolve_gateway_clarify(successor.clarify_id, "A"))
+        finally:
+            queue.clear_session(self.key)
+
+
+if __name__ == "__main__":
+    unittest.main()
