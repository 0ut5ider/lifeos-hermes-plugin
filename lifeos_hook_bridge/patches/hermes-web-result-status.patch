+
+def web_extract_result_failed(tool_name: str, result: Any) -> bool | None:
+    """Classify the structured extraction envelope without interpreting document text."""
+    if tool_name != "web_extract":
+        return None
+    data = result
+    if isinstance(data, str):
+        try:
+            data = json.loads(data)
+        except (TypeError, ValueError):
+            return None
+    if not isinstance(data, dict):
+        return None
+    if data.get("error") or data.get("success") is False:
+        return True
+    rows = data.get("results")
+    if not isinstance(rows, list) or not rows or not all(isinstance(row, dict) for row in rows):
+        return None
+    return not any(isinstance(row.get("content"), str) and row["content"].strip()
+                   and not row.get("error") for row in rows)
