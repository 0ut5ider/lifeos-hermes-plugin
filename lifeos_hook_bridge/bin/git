#!/usr/bin/env python3
# ABOUTME: Supplies fixed read-only Git answers to the native VersionDrift hook.
# ABOUTME: Delegates every unrelated Git command to the system Git executable.

import importlib.util
import os
import sys
from pathlib import Path

module_path = Path(__file__).resolve().parents[1] / "version_drift.py"
module_spec = importlib.util.spec_from_file_location("lifeos_version_drift", module_path)
if module_spec is None or module_spec.loader is None:
    raise ImportError("LifeOS VersionDrift module is unavailable")
version_drift = importlib.util.module_from_spec(module_spec)
module_spec.loader.exec_module(version_drift)


def main() -> int:
    system_git = os.environ.get("LIFEOS_VERSION_DRIFT_SYSTEM_GIT", "/usr/bin/git")
    args = sys.argv[1:]
    root_text = os.environ.get("LIFEOS_VERSION_DRIFT_ROOT", "")
    baseline_text = os.environ.get("LIFEOS_VERSION_DRIFT_BASELINE", "")
    if len(args) < 3 or args[0] != "-C" or not root_text or not baseline_text:
        os.execv(system_git, [system_git, *args])
    root = Path(root_text).resolve()
    if Path(args[1]).resolve() != root or args[2] not in {"tag", "diff", "log"}:
        os.execv(system_git, [system_git, *args])
    try:
        baseline = version_drift.load_baseline(Path(baseline_text), root)
        sys.stdout.write(version_drift.git_response(baseline, root, args[2:]))
    except (OSError, ValueError, KeyError, TypeError) as error:
        try:
            version_drift.record_adapter_error(Path(baseline_text), str(error))
        except OSError:
            pass
        print(f"LifeOS VersionDrift baseline unavailable: {error}", file=sys.stderr)
        return 2
    version_drift.adapter_error_path(Path(baseline_text)).unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
