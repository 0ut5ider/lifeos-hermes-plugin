#!/usr/bin/env bash
# ABOUTME: Routes LifeOS child Claude calls to a configured local model.
# ABOUTME: Restores gateway settings that LifeOS inference removes from its child environment.
set -euo pipefail
account_home="${LIFEOS_ACCOUNT_HOME:-$HOME}"
model_env="${LIFEOS_HOOK_MODEL_ENV:-$account_home/.config/lifeos-hook-bridge/model.env}"
if [[ -r "$model_env" ]]; then
  set -a
  source "$model_env"
  set +a
fi
args=("$@")
requested_model=""
for (( i=0; i<${#args[@]}; i++ )); do
  case "${args[i]}" in
    --model)
      if (( i + 1 < ${#args[@]} )); then requested_model="${args[i+1]}"; fi
      ;;
    --model=*) requested_model="${args[i]#--model=}" ;;
  esac
done
route_text="$(python3 "$(dirname "$0")/../model_tiers.py" "$requested_model")"
mapfile -t route <<< "$route_text"
local_model="${route[0]}"
local_effort="${route[1]}"
local_provider="${route[2]:-}"
for (( i=0; i<${#args[@]}; i++ )); do
  case "${args[i]}" in
    --model|--effort)
      if (( i + 1 < ${#args[@]} )); then
        if [[ "${args[i]}" == --model ]]; then args[i+1]="$local_model"; else args[i+1]="$local_effort"; fi
      fi
      (( i+=1 ))
      ;;
    --model=*) args[i]="--model=$local_model" ;;
    --effort=*) args[i]="--effort=$local_effort" ;;
  esac
done
if [[ -n "$local_provider" ]]; then
  export LIFEOS_CHILD_PROVIDER="$local_provider"
  exec hermes lifeos-infer "${args[@]}"
fi
if [[ "${LIFEOS_CHILD_INFERENCE_DIRECT:-0}" == 1 ]]; then
  exec python3 "$(dirname "$0")/claude_direct.py" "${args[@]}"
fi
if [[ -n "${LIFEOS_MEMORY_CONTEXT:-}" ]]; then
  printf '%s\n' 'LifeOS lasting memory requires child inference through the plugin.' >&2
  exit 1
fi
exec "$account_home/.local/bin/claude" "${args[@]}"
