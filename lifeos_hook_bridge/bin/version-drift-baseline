#!/usr/bin/env python3
# ABOUTME: Previews and creates a private baseline for installed LifeOS system files.
# ABOUTME: Requires explicit approval to write or renew the baseline.

import importlib.util
import argparse
import json
from pathlib import Path

module_path = Path(__file__).resolve().parents[1] / "version_drift.py"
module_spec = importlib.util.spec_from_file_location("lifeos_version_drift", module_path)
if module_spec is None or module_spec.loader is None:
    raise ImportError("LifeOS VersionDrift module is unavailable")
version_drift = importlib.util.module_from_spec(module_spec)
module_spec.loader.exec_module(version_drift)


def main() -> int:
    parser = argparse.ArgumentParser(description="Preview or create the LifeOS VersionDrift baseline")
    parser.add_argument("--source", type=Path, required=True, help="LifeOS source install directory")
    parser.add_argument("--installed", type=Path, default=Path.home() / ".claude")
    parser.add_argument("--baseline", type=Path, default=version_drift.default_baseline_path())
    parser.add_argument("--apply", action="store_true", help="Write the reviewed baseline")
    parser.add_argument("--renew", action="store_true", help="Replace an existing baseline")
    args = parser.parse_args()
    if args.renew and not args.apply:
        parser.error("--renew requires --apply")
    try:
        baseline = version_drift.create_baseline(args.source, args.installed)
        if args.apply:
            version_drift.save_baseline(baseline, args.baseline, renew=args.renew)
    except (OSError, ValueError, RuntimeError) as error:
        parser.exit(1, f"VersionDrift baseline failed: {error}\n")
    print(json.dumps({
        "action": "written" if args.apply else "preview",
        "baseline": str(args.baseline),
        "version": baseline["version"],
        "source_commit": baseline["source_commit"],
        "created_at": baseline["created_at"],
        "file_count": len(baseline["files"]),
        "files": list(baseline["files"]),
    }, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
